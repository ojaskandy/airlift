#!/bin/bash

set -euo pipefail

if [ -n "${AIRLIFT_TEST_SSH_LOG:-}" ]; then
  printf '%s\n' "$*" >>"$AIRLIFT_TEST_SSH_LOG"
fi

last="${!#}"
if [[ "$last" == *"IOPlatformUUID"* ]]; then
  host="unknown"
  previous=""
  for arg in "$@"; do
    if [ "$arg" = "$last" ]; then
      host="$previous"
      break
    fi
    previous="$arg"
  done
  printf 'uuid-%s\n' "$host"
  exit 0
fi
if [ "$last" = "airlift-uuid" ]; then
  host="unknown"
  prev=""
  for arg in "$@"; do
    if [ "$arg" = "airlift-uuid" ]; then
      host="$prev"
    fi
    prev="$arg"
  done
  printf 'uuid-%s\n' "$host"
  exit 0
fi
if [[ "$last" == *"AIRLIFT_METRICS=1"* ]] && [ -n "${AIRLIFT_TEST_METRICS_DIR:-}" ]; then
  for arg in "$@"; do
    if [ -f "$AIRLIFT_TEST_METRICS_DIR/$arg" ]; then
      cat "$AIRLIFT_TEST_METRICS_DIR/$arg"
      exit 0
    fi
  done
  exit 255
fi

for arg in "$@"; do
  case "$arg" in
    -fN)
      exit 0
      ;;
  esac
done

previous=""
for arg in "$@"; do
  if [ "$previous" = "-O" ] && [ "$arg" = "exit" ]; then
    exit 0
  fi
  previous="$arg"
done

case "$last" in
  true)
    exit 0
    ;;
  *)
    exec bash -c "$last"
    ;;
esac
