set -u
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.codex/bin:$PATH"

# Which ChatGPT account Codex would spend quota as. Reads only the identity
# claims of the local id_token; never prints tokens.
codex_identity() {
  auth_file="$HOME/.codex/auth.json"
  [ -f "$auth_file" ] || return 1
  command -v node >/dev/null 2>&1 || return 1
  node -e '
    const fs = require("fs");
    try {
      const auth = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
      const token = auth.tokens && auth.tokens.id_token;
      if (!token) {
        process.stdout.write(auth.OPENAI_API_KEY ? "api-key" : "");
        process.exit(0);
      }
      const claims = JSON.parse(
        Buffer.from(token.split(".")[1], "base64url").toString("utf8")
      );
      process.stdout.write(claims.email || "");
    } catch (error) {
      process.exit(1);
    }
  ' "$auth_file" 2>/dev/null
}

codex_plan() {
  auth_file="$HOME/.codex/auth.json"
  [ -f "$auth_file" ] || return 1
  command -v node >/dev/null 2>&1 || return 1
  node -e '
    const fs = require("fs");
    try {
      const auth = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
      const token = auth.tokens && auth.tokens.id_token;
      if (!token) process.exit(0);
      const claims = JSON.parse(
        Buffer.from(token.split(".")[1], "base64url").toString("utf8")
      );
      const detail = claims["https://api.openai.com/auth"] || {};
      process.stdout.write(detail.chatgpt_plan_type || "");
    } catch (error) {
      process.exit(1);
    }
  ' "$auth_file" 2>/dev/null
}

claude_field() {
  command -v node >/dev/null 2>&1 || return 1
  claude auth status 2>/dev/null | node -e '
    let raw = "";
    process.stdin.on("data", (chunk) => (raw += chunk));
    process.stdin.on("end", () => {
      try {
        process.stdout.write(String(JSON.parse(raw)[process.argv[1]] || ""));
      } catch (error) {
        process.exit(1);
      }
    });
  ' "$1" 2>/dev/null
}

printf '\nRemote machine\n'
printf '  Name:    %s\n' "$(scutil --get ComputerName 2>/dev/null || hostname)"
printf '  macOS:   %s\n' "$(sw_vers -productVersion 2>/dev/null || printf unknown)"
printf '  Chip:    %s\n' "$(uname -m)"
printf '  Shell:   %s\n' "${SHELL:-unknown}"

disk_free_gb="$(df -g "$HOME" 2>/dev/null | awk 'NR == 2 { print $4 }')"
printf '  Disk:    %s (%s used)\n' \
  "$(df -h "$HOME" | awk 'NR == 2 { print $4 " free" }')" \
  "$(df -h "$HOME" | awk 'NR == 2 { print $5 }')"
case "$disk_free_gb" in
  ''|*[!0-9]*) ;;
  *)
    if [ "$disk_free_gb" -lt "$AIRLIFT_MIN_DISK_GB" ]; then
      printf '  ! Only %sGi free. Airlift wants at least %sGi to clone and build safely.\n' \
        "$disk_free_gb" "$AIRLIFT_MIN_DISK_GB"
      printf '    Cloning a large repository or running a build may fail or fill the disk.\n'
    fi
    ;;
esac

printf '\nAgents\n'
codex_account=""
claude_account=""

if command -v codex >/dev/null 2>&1; then
  printf '  Codex:   %s\n' "$(codex --version 2>/dev/null)"
  if codex login status >/dev/null 2>&1; then
    codex_account="$(codex_identity || true)"
    codex_plan_name="$(codex_plan || true)"
    if [ -n "$codex_account" ]; then
      if [ -n "$codex_plan_name" ]; then
        printf '  Auth:    %s (%s)\n' "$codex_account" "$codex_plan_name"
      else
        printf '  Auth:    %s\n' "$codex_account"
      fi
    else
      printf '  Auth:    ready (account could not be identified)\n'
    fi
  else
    printf '  Auth:    sign-in required\n'
  fi
else
  printf '  Codex:   not installed\n'
fi

if command -v claude >/dev/null 2>&1; then
  printf '  Claude:  %s\n' "$(claude --version 2>/dev/null)"
  if claude auth status >/dev/null 2>&1; then
    claude_account="$(claude_field email || true)"
    claude_plan="$(claude_field subscriptionType || true)"
    if [ -n "$claude_account" ]; then
      if [ -n "$claude_plan" ]; then
        printf '  Auth:    %s (%s)\n' "$claude_account" "$claude_plan"
      else
        printf '  Auth:    %s\n' "$claude_account"
      fi
    else
      printf '  Auth:    ready (account could not be identified)\n'
    fi
  else
    printf '  Auth:    sign-in required\n'
  fi
else
  printf '  Claude:  not installed\n'
fi

if command -v yepanywhere >/dev/null 2>&1; then
  cockpit_version="$(yepanywhere --version 2>/dev/null)"
  if curl -fsS "http://127.0.0.1:$AIRLIFT_PORT/api/version" 2>/dev/null |
    grep -F '"current"' >/dev/null 2>&1; then
    printf '  Cockpit: yepanywhere %s (serving on 127.0.0.1:%s)\n' \
      "$cockpit_version" "$AIRLIFT_PORT"
  else
    printf '  Cockpit: yepanywhere %s (installed, not serving. Run: airlift open)\n' \
      "$cockpit_version"
  fi
else
  printf '  Cockpit: not installed\n'
fi

# The cockpit's provider picker spends whichever account each agent is signed in
# as. Different accounts means one of them is not yours.
if [ -n "$codex_account" ] && [ -n "$claude_account" ] &&
  [ "$codex_account" != "$claude_account" ]; then
  printf '\n  ! Codex and Claude are signed in as DIFFERENT accounts.\n'
  printf '      Codex:  %s\n' "$codex_account"
  printf '      Claude: %s\n' "$claude_account"
  printf '    Choosing Codex in the cockpit spends %s quota, under that identity.\n' \
    "$codex_account"
  printf '    Fix with: airlift login codex\n'
fi

printf '\nPower\n'
if command -v pmset >/dev/null 2>&1; then
  ac_sleep="$(
    pmset -g custom 2>/dev/null |
      awk '/AC Power/ { ac = 1; next } ac && / sleep / { print $2; exit }'
  )"
  [ -n "$ac_sleep" ] && printf '  AC sleep:   %s minutes when idle and unheld\n' "$ac_sleep"
  power_source="$(
    pmset -g batt 2>/dev/null | awk -F "'" '/Now drawing/ { print $2; exit }'
  )"
  [ -n "$power_source" ] && printf '  Source:     %s\n' "$power_source"
fi

# Ground truth is the pmset assertion, not the pid file: a pid can be alive
# while holding no assertion, and caffeinate -s only holds on AC power.
supervised=0
if [ -f "$HOME/.airlift/keepawake.pid" ]; then
  supervisor_pid="$(cat "$HOME/.airlift/keepawake.pid" 2>/dev/null || true)"
  if [ -n "$supervisor_pid" ] && kill -0 "$supervisor_pid" 2>/dev/null; then
    case "$(ps -p "$supervisor_pid" -o command= 2>/dev/null || true)" in
      *keepawake.sh*) supervised=1 ;;
    esac
  fi
fi

# launchd management means keep-awake also survives a reboot, not just a crash.
launchd_managed=0
if command -v launchctl >/dev/null 2>&1; then
  if launchctl print "gui/$(id -u)/com.airlift.keepawake" >/dev/null 2>&1; then
    launchd_managed=1
  fi
fi

asserted=0
if [ -f "$HOME/.airlift/caffeinate.pid" ] && command -v pmset >/dev/null 2>&1; then
  caffeinate_pid="$(cat "$HOME/.airlift/caffeinate.pid" 2>/dev/null || true)"
  if [ -n "$caffeinate_pid" ] && kill -0 "$caffeinate_pid" 2>/dev/null; then
    if pmset -g assertions 2>/dev/null |
      grep -F "pid $caffeinate_pid(caffeinate)" >/dev/null 2>&1; then
      asserted=1
    fi
  fi
fi

if [ "$asserted" -eq 1 ] && [ "$launchd_managed" -eq 1 ]; then
  printf '  Keep-awake: active and supervised by launchd (survives reboot)\n'
elif [ "$asserted" -eq 1 ] && [ "$supervised" -eq 1 ]; then
  printf '  Keep-awake: active and supervised (restarts if it dies)\n'
  printf '  ! Not registered with launchd, will NOT restart after an Air reboot. Run: airlift awake\n'
elif [ "$asserted" -eq 1 ]; then
  printf '  Keep-awake: active, NOT supervised\n'
  printf '  ! If this assertion dies the Air sleeps and all remote work stops.\n'
  printf '    Re-run: airlift awake\n'
else
  printf '  Keep-awake: NOT ACTIVE\n'
  printf '  ! Airlift is holding no keep-awake assertion.\n'
  if [ -n "${ac_sleep:-}" ] && [ "${ac_sleep:-0}" != "0" ]; then
    printf '    The Air sleeps after %s idle minutes on AC and all remote work stops.\n' \
      "$ac_sleep"
  fi
  printf '    Start it with: airlift awake\n'
fi

case "${power_source:-}" in
  *Battery*)
    printf '  ! On battery power. caffeinate -s only holds on AC.\n'
    printf '    Plug the Air in to keep agents running.\n'
    ;;
esac
REMOTE

  if curl -fsS "http://127.0.0.1:$AIRLIFT_LOCAL_PORT/api/version" 2>/dev/null |
    grep -F '"current"' >/dev/null 2>&1; then
    say ""
    say "Tunnel:   live on 127.0.0.1:$AIRLIFT_LOCAL_PORT (Pro → Air)"
  else
    say ""
    say "Tunnel:   down. Run: airlift open"
  fi

  say ""
  say "Security: SSH key only, agent forwarding disabled, cockpit bound to Air loopback."
}

