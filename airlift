#!/bin/bash

set -euo pipefail

VERSION="0.1.0"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/airlift"
CONFIG_FILE="$CONFIG_DIR/config"
KEY_FILE="$HOME/.ssh/airlift_ed25519"
SSH_CONFIG="$HOME/.ssh/config"

if [ -t 1 ]; then
  BOLD=$'\033[1m'
  DIM=$'\033[2m'
  GREEN=$'\033[32m'
  YELLOW=$'\033[33m'
  RED=$'\033[31m'
  CYAN=$'\033[36m'
  RESET=$'\033[0m'
else
  BOLD=""
  DIM=""
  GREEN=""
  YELLOW=""
  RED=""
  CYAN=""
  RESET=""
fi

say() {
  printf '%s\n' "$*"
}

info() {
  printf '%s●%s %s\n' "$CYAN" "$RESET" "$*"
}

ok() {
  printf '%s✓%s %s\n' "$GREEN" "$RESET" "$*"
}

warn() {
  printf '%s!%s %s\n' "$YELLOW" "$RESET" "$*" >&2
}

die() {
  printf '%sError:%s %s\n' "$RED" "$RESET" "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Airlift — run engineering agents on a spare Mac over SSH.

Usage:
  airlift setup <user@mac-host> [--alias spare-air] [--install all|codex|opencode|none] [--no-awake]
  airlift codex
  airlift web [remote-project] [--local-port 4096] [--remote-port 4096]
  airlift clone <git-url> [remote-directory]
  airlift login [codex|opencode]
  airlift shell
  airlift awake
  airlift sleep
  airlift stop
  airlift doctor
  airlift config
  airlift version

Fast path:
  airlift setup dylan@Dylans-MacBook-Air.local
  airlift codex

Open-source browser path:
  airlift web '~/Developer/my-project'
EOF
}

require() {
  command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

shell_quote() {
  local value="$1"
  printf "'%s'" "$(printf '%s' "$value" | sed "s/'/'\\\\''/g")"
}

validate_alias() {
  case "$1" in
    ""|*[!A-Za-z0-9._-]*)
      die "SSH alias may only contain letters, numbers, dots, underscores, and hyphens."
      ;;
  esac
}

validate_port() {
  case "$1" in
    ""|*[!0-9]*) die "Invalid port: $1" ;;
  esac
  [ "$1" -ge 1024 ] && [ "$1" -le 65535 ] || die "Port must be between 1024 and 65535."
}

load_config() {
  [ -f "$CONFIG_FILE" ] || die "Airlift is not paired yet. Run: airlift setup user@mac-host"
  # The file is generated by Airlift, owned by the current user, and chmod 600.
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
  AIRLIFT_LOCAL_PORT="${AIRLIFT_LOCAL_PORT:-4096}"
  AIRLIFT_REMOTE_PORT="${AIRLIFT_REMOTE_PORT:-4096}"
  AIRLIFT_PROJECT="${AIRLIFT_PROJECT:-~}"
  validate_alias "$AIRLIFT_ALIAS"
}

save_config() {
  mkdir -p "$CONFIG_DIR"
  chmod 700 "$CONFIG_DIR"
  umask 077
  local temp
  temp="$(mktemp "$CONFIG_DIR/config.XXXXXX")"
  {
    printf 'AIRLIFT_ALIAS=%q\n' "$AIRLIFT_ALIAS"
    printf 'AIRLIFT_TARGET=%q\n' "$AIRLIFT_TARGET"
    printf 'AIRLIFT_LOCAL_PORT=%q\n' "${AIRLIFT_LOCAL_PORT:-4096}"
    printf 'AIRLIFT_REMOTE_PORT=%q\n' "${AIRLIFT_REMOTE_PORT:-4096}"
    printf 'AIRLIFT_PROJECT=%q\n' "${AIRLIFT_PROJECT:-~}"
  } >"$temp"
  chmod 600 "$temp"
  mv "$temp" "$CONFIG_FILE"
}

ssh_socket() {
  printf '/tmp/airlift-%s-%s.sock' "$UID" "$AIRLIFT_ALIAS"
}

remote_path_prefix() {
  printf '%s' 'export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$HOME/.opencode/bin:$HOME/.codex/bin:$PATH";'
}

add_ssh_config() {
  local alias="$1"
  local hostname="$2"
  local username="$3"
  local start="# >>> airlift:${alias} >>>"
  local end="# <<< airlift:${alias} <<<"
  local temp

  mkdir -p "$HOME/.ssh"
  chmod 700 "$HOME/.ssh"
  touch "$SSH_CONFIG"
  chmod 600 "$SSH_CONFIG"
  cp "$SSH_CONFIG" "$SSH_CONFIG.airlift.bak"
  temp="$(mktemp "$HOME/.ssh/config.XXXXXX")"

  awk -v start="$start" -v end="$end" '
    $0 == start { skipping = 1; next }
    $0 == end { skipping = 0; next }
    !skipping { print }
  ' "$SSH_CONFIG" >"$temp"

  cat >>"$temp" <<EOF

$start
Host $alias
  HostName $hostname
  User $username
  IdentityFile $KEY_FILE
  IdentitiesOnly yes
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 30
  ServerAliveCountMax 3
  TCPKeepAlive yes
  ForwardAgent no
$end
EOF

  chmod 600 "$temp"
  mv "$temp" "$SSH_CONFIG"
}

remote_install() {
  local install_mode="$1"
  local quoted_mode
  quoted_mode="$(shell_quote "$install_mode")"

  info "Checking the Air and installing requested agents…"
  ssh "$AIRLIFT_ALIAS" "AIRLIFT_INSTALL=$quoted_mode bash -s" <<'REMOTE'
set -eu

export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$HOME/.opencode/bin:$HOME/.codex/bin:$PATH"
mkdir -p "$HOME/.airlift/logs" "$HOME/.local/bin"

add_login_path() {
  profile="$1"
  marker="# Added by Airlift"
  line='export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$HOME/.opencode/bin:$HOME/.codex/bin:$PATH"'
  touch "$profile"
  if ! grep -F "$marker" "$profile" >/dev/null 2>&1; then
    {
      printf '\n%s\n' "$marker"
      printf '%s\n' "$line"
    } >>"$profile"
  fi
}

add_login_path "$HOME/.zprofile"
add_login_path "$HOME/.bash_profile"

install_codex() {
  if command -v codex >/dev/null 2>&1; then
    return
  fi

  printf 'Installing Codex CLI on the Air…\n'
  if command -v brew >/dev/null 2>&1; then
    brew install --cask codex
  elif command -v npm >/dev/null 2>&1; then
    npm install -g @openai/codex
  elif command -v curl >/dev/null 2>&1; then
    curl -fsSL https://chatgpt.com/codex/install.sh | sh
  else
    printf 'No Homebrew, npm, or curl is available to install Codex.\n' >&2
    exit 1
  fi
  hash -r
}

install_opencode() {
  if command -v opencode >/dev/null 2>&1; then
    return
  fi

  printf 'Installing OpenCode on the Air…\n'
  if command -v brew >/dev/null 2>&1; then
    brew install anomalyco/tap/opencode
  elif command -v npm >/dev/null 2>&1; then
    npm install -g opencode-ai
  elif command -v curl >/dev/null 2>&1; then
    curl -fsSL https://opencode.ai/install | bash
  else
    printf 'No Homebrew, npm, or curl is available to install OpenCode.\n' >&2
    exit 1
  fi
  hash -r
}

case "$AIRLIFT_INSTALL" in
  all)
    install_codex
    install_opencode
    ;;
  codex)
    install_codex
    ;;
  opencode)
    install_opencode
    ;;
  none)
    ;;
  *)
    printf 'Unknown install mode: %s\n' "$AIRLIFT_INSTALL" >&2
    exit 1
    ;;
esac

printf 'Remote: %s · %s · %s\n' "$(scutil --get ComputerName 2>/dev/null || hostname)" "$(uname -m)" "$(sw_vers -productVersion 2>/dev/null || uname -r)"
if command -v codex >/dev/null 2>&1; then
  codex --version
fi
if command -v opencode >/dev/null 2>&1; then
  printf 'opencode %s\n' "$(opencode --version)"
fi
REMOTE
}

setup_cmd() {
  require ssh
  require ssh-keygen
  require ssh-copy-id

  [ "$#" -ge 1 ] || die "Usage: airlift setup <user@mac-host> [--alias spare-air] [--install all|codex|opencode|none] [--no-awake]"

  local target="$1"
  shift
  local alias="spare-air"
  local install_mode="all"
  local keep_awake="1"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --alias)
        [ "$#" -ge 2 ] || die "--alias needs a value."
        alias="$2"
        shift 2
        ;;
      --install)
        [ "$#" -ge 2 ] || die "--install needs a value."
        install_mode="$2"
        shift 2
        ;;
      --no-awake)
        keep_awake="0"
        shift
        ;;
      *)
        die "Unknown setup option: $1"
        ;;
    esac
  done

  validate_alias "$alias"
  case "$install_mode" in all|codex|opencode|none) ;; *) die "Install mode must be all, codex, opencode, or none." ;; esac

  local username hostname
  if [[ "$target" == *"@"* ]]; then
    username="${target%@*}"
    hostname="${target#*@}"
  else
    username="$USER"
    hostname="$target"
    target="$username@$hostname"
  fi

  case "$username" in ""|*[!A-Za-z0-9._-]*) die "Invalid SSH username: $username" ;; esac
  case "$hostname" in ""|*[!A-Za-z0-9._:-]*) die "Invalid SSH hostname: $hostname" ;; esac

  say ""
  say "${BOLD}Airlift setup${RESET}"
  say "${DIM}MacBook Pro → $target${RESET}"
  say ""

  if [ ! -f "$KEY_FILE" ]; then
    info "Creating a dedicated SSH key at $KEY_FILE"
    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    ssh-keygen -q -t ed25519 -f "$KEY_FILE" -N "" -C "airlift@${HOSTNAME:-$(hostname)}"
    chmod 600 "$KEY_FILE"
    chmod 644 "$KEY_FILE.pub"
  else
    ok "Dedicated SSH key already exists."
  fi

  add_ssh_config "$alias" "$hostname" "$username"
  ok "Added concrete SSH host '$alias' for Codex auto-discovery."

  if ! ssh -o BatchMode=yes -o ConnectTimeout=6 "$alias" true >/dev/null 2>&1; then
    warn "One Mac password prompt may appear to authorize Dylan's SSH key."
    if ! ssh-copy-id -i "$KEY_FILE.pub" -o StrictHostKeyChecking=accept-new "$target"; then
      say ""
      warn "Could not reach the Air."
      say "On the Air, enable: System Settings → General → Sharing → Remote Login"
      say "Allow access for the '$username' user, then rerun the setup command."
      exit 1
    fi
  fi

  ssh -o BatchMode=yes -o ConnectTimeout=8 "$alias" true >/dev/null
  ok "Passwordless SSH is working."

  AIRLIFT_ALIAS="$alias"
  AIRLIFT_TARGET="$target"
  AIRLIFT_LOCAL_PORT="4096"
  AIRLIFT_REMOTE_PORT="4096"
  AIRLIFT_PROJECT="~"
  save_config

  remote_install "$install_mode"

  if [ "$install_mode" = "all" ] || [ "$install_mode" = "codex" ]; then
    if ! ssh "$AIRLIFT_ALIAS" "$(remote_path_prefix) codex login status" >/dev/null 2>&1; then
      say ""
      info "Codex needs a one-time sign-in on the Air."
      ssh -t "$AIRLIFT_ALIAS" "$(remote_path_prefix) codex login --device-auth"
    else
      ok "Codex is authenticated on the Air."
    fi
  fi

  if [ "$keep_awake" = "1" ]; then
    awake_cmd
  fi

  say ""
  ok "The Macs are paired."
  say ""
  say "Open the native remote workspace:"
  say "  ${BOLD}./airlift codex${RESET}"
  say ""
  say "Or launch the open-source browser workspace:"
  say "  ${BOLD}./airlift web '~/Developer/your-project'${RESET}"
}

codex_cmd() {
  load_config

  if ! ssh -o BatchMode=yes -o ConnectTimeout=6 "$AIRLIFT_ALIAS" "$(remote_path_prefix) command -v codex >/dev/null && codex login status >/dev/null" >/dev/null 2>&1; then
    warn "Codex is not installed or authenticated on the Air."
    say "Run: airlift login codex"
    exit 1
  fi

  if ! open -Ra Codex >/dev/null 2>&1; then
    warn "The Codex desktop app is not installed on this Mac."
    say "Install it from: https://chatgpt.com/codex"
    open "https://chatgpt.com/codex"
    exit 1
  fi

  info "Opening Codex and adding '$AIRLIFT_ALIAS' as a remote SSH host…"
  open "codex://settings/connections/ssh/add?name=$AIRLIFT_ALIAS"
  say ""
  say "In Codex, choose a project folder on ${BOLD}$AIRLIFT_ALIAS${RESET}."
  say "Prompts, commands, tests, worktrees, and file edits will run on the Air."
}

stop_tunnel_only() {
  local socket
  socket="$(ssh_socket)"
  if [ -S "$socket" ]; then
    ssh -S "$socket" -O exit "$AIRLIFT_ALIAS" >/dev/null 2>&1 || true
    rm -f "$socket"
  fi
}

stop_cmd() {
  load_config
  stop_tunnel_only

  local quoted_port
  quoted_port="$(shell_quote "$AIRLIFT_REMOTE_PORT")"
  ssh "$AIRLIFT_ALIAS" "AIRLIFT_PORT=$quoted_port bash -s" <<'REMOTE' >/dev/null 2>&1 || true
set -eu
pid_file="$HOME/.airlift/opencode-$AIRLIFT_PORT.pid"
if [ -f "$pid_file" ]; then
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    command_line="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    case "$command_line" in
      *opencode*) kill "$pid" 2>/dev/null || true ;;
    esac
  fi
  rm -f "$pid_file"
fi
REMOTE
  ok "Stopped the OpenCode web session and SSH tunnel."
}

web_cmd() {
  load_config
  require ssh
  require open

  local project="$AIRLIFT_PROJECT"
  local local_port="$AIRLIFT_LOCAL_PORT"
  local remote_port="$AIRLIFT_REMOTE_PORT"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --local-port)
        [ "$#" -ge 2 ] || die "--local-port needs a value."
        local_port="$2"
        shift 2
        ;;
      --remote-port)
        [ "$#" -ge 2 ] || die "--remote-port needs a value."
        remote_port="$2"
        shift 2
        ;;
      -*)
        die "Unknown web option: $1"
        ;;
      *)
        project="$1"
        shift
        ;;
    esac
  done

  validate_port "$local_port"
  validate_port "$remote_port"

  AIRLIFT_LOCAL_PORT="$local_port"
  AIRLIFT_REMOTE_PORT="$remote_port"
  AIRLIFT_PROJECT="$project"
  save_config

  if ! ssh "$AIRLIFT_ALIAS" "$(remote_path_prefix) command -v opencode >/dev/null" >/dev/null 2>&1; then
    die "OpenCode is not installed on the Air. Rerun setup with: --install opencode"
  fi

  stop_tunnel_only

  if command -v lsof >/dev/null 2>&1 && lsof -nP -iTCP:"$local_port" -sTCP:LISTEN >/dev/null 2>&1; then
    die "Local port $local_port is already in use. Try: airlift web --local-port 4097"
  fi

  local quoted_project quoted_port
  quoted_project="$(shell_quote "$project")"
  quoted_port="$(shell_quote "$remote_port")"

  info "Starting OpenCode on the Air in $project…"
  ssh "$AIRLIFT_ALIAS" "AIRLIFT_PROJECT=$quoted_project AIRLIFT_PORT=$quoted_port bash -s" <<'REMOTE'
set -eu
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$HOME/.opencode/bin:$HOME/.codex/bin:$PATH"

project="$AIRLIFT_PROJECT"
case "$project" in
  "~") project="$HOME" ;;
  "~/"*) project="$HOME/${project#\~/}" ;;
esac

[ -d "$project" ] || {
  printf 'Remote project does not exist: %s\n' "$project" >&2
  exit 1
}

mkdir -p "$HOME/.airlift/logs"
pid_file="$HOME/.airlift/opencode-$AIRLIFT_PORT.pid"
log_file="$HOME/.airlift/logs/opencode-$AIRLIFT_PORT.log"

if [ -f "$pid_file" ]; then
  old_pid="$(cat "$pid_file" 2>/dev/null || true)"
  if [ -n "$old_pid" ] && kill -0 "$old_pid" 2>/dev/null; then
    old_command="$(ps -p "$old_pid" -o command= 2>/dev/null || true)"
    case "$old_command" in
      *opencode*) kill "$old_pid" 2>/dev/null || true ;;
    esac
  fi
fi

cd "$project"
OPENCODE_BIN="$(command -v opencode)"
BROWSER=/usr/bin/false nohup "$OPENCODE_BIN" web \
  --hostname 127.0.0.1 \
  --port "$AIRLIFT_PORT" \
  >"$log_file" 2>&1 </dev/null &
pid="$!"
printf '%s\n' "$pid" >"$pid_file"

ready=0
attempt=0
while [ "$attempt" -lt 40 ]; do
  if curl -fsS "http://127.0.0.1:$AIRLIFT_PORT/" >/dev/null 2>&1; then
    ready=1
    break
  fi
  if ! kill -0 "$pid" 2>/dev/null; then
    break
  fi
  attempt=$((attempt + 1))
  sleep 0.25
done

if [ "$ready" -ne 1 ]; then
  tail -n 30 "$log_file" >&2 || true
  exit 1
fi
REMOTE

  local socket
  socket="$(ssh_socket)"
  rm -f "$socket"
  ssh -fN -M -S "$socket" \
    -o ExitOnForwardFailure=yes \
    -o ControlPersist=no \
    -L "$local_port:127.0.0.1:$remote_port" \
    "$AIRLIFT_ALIAS"

  ok "Private tunnel is live: MacBook Pro → MacBook Air"
  open "http://127.0.0.1:$local_port"
  say ""
  say "OpenCode is running on the Air. This terminal can close."
  say "Stop it later with: ${BOLD}airlift stop${RESET}"
}

clone_cmd() {
  load_config
  [ "$#" -ge 1 ] || die "Usage: airlift clone <git-url> [remote-directory]"

  local url="$1"
  local destination="${2:-}"
  local name
  name="$(basename "${url%.git}")"
  [ -n "$destination" ] || destination="~/Developer/$name"

  local quoted_url quoted_destination
  quoted_url="$(shell_quote "$url")"
  quoted_destination="$(shell_quote "$destination")"

  info "Cloning $url on the Air…"
  ssh "$AIRLIFT_ALIAS" "AIRLIFT_URL=$quoted_url AIRLIFT_DEST=$quoted_destination bash -s" <<'REMOTE'
set -eu
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$HOME/.opencode/bin:$HOME/.codex/bin:$PATH"
destination="$AIRLIFT_DEST"
case "$destination" in
  "~") destination="$HOME" ;;
  "~/"*) destination="$HOME/${destination#\~/}" ;;
esac
mkdir -p "$(dirname "$destination")"
git clone -- "$AIRLIFT_URL" "$destination"
printf '\nCloned to %s\n' "$destination"
REMOTE

  AIRLIFT_PROJECT="$destination"
  save_config
  ok "Saved $destination as the default remote project."
}

login_cmd() {
  load_config
  local provider="${1:-codex}"
  case "$provider" in
    codex)
      ssh -t "$AIRLIFT_ALIAS" "$(remote_path_prefix) codex login --device-auth"
      ;;
    opencode)
      ssh -t "$AIRLIFT_ALIAS" "$(remote_path_prefix) opencode auth login"
      ;;
    *)
      die "Login target must be codex or opencode."
      ;;
  esac
}

shell_cmd() {
  load_config
  exec ssh "$AIRLIFT_ALIAS"
}

awake_cmd() {
  load_config
  ssh "$AIRLIFT_ALIAS" "bash -s" <<'REMOTE'
set -eu
mkdir -p "$HOME/.airlift/logs"
pid_file="$HOME/.airlift/caffeinate.pid"

if [ -f "$pid_file" ]; then
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    command_line="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    case "$command_line" in
      *caffeinate*) exit 0 ;;
    esac
  fi
fi

nohup /usr/bin/caffeinate -s >"$HOME/.airlift/logs/caffeinate.log" 2>&1 </dev/null &
printf '%s\n' "$!" >"$pid_file"
REMOTE
  ok "The Air will stay awake while connected to AC power."
}

sleep_cmd() {
  load_config
  ssh "$AIRLIFT_ALIAS" "bash -s" <<'REMOTE'
set -eu
pid_file="$HOME/.airlift/caffeinate.pid"
if [ -f "$pid_file" ]; then
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    command_line="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    case "$command_line" in
      *caffeinate*) kill "$pid" 2>/dev/null || true ;;
    esac
  fi
  rm -f "$pid_file"
fi
REMOTE
  ok "Released Airlift's keep-awake assertion."
}

doctor_cmd() {
  load_config
  require ssh

  say ""
  say "${BOLD}Airlift doctor${RESET}"
  say ""

  if ssh -o BatchMode=yes -o ConnectTimeout=8 "$AIRLIFT_ALIAS" true >/dev/null 2>&1; then
    ok "SSH connection to $AIRLIFT_ALIAS"
  else
    warn "SSH connection failed."
    say "Check that the Air is awake and Remote Login is enabled."
    exit 1
  fi

  if open -Ra Codex >/dev/null 2>&1; then
    ok "Codex desktop app is installed on the Pro"
  else
    warn "Codex desktop app is not installed on the Pro"
  fi

  ssh "$AIRLIFT_ALIAS" "bash -s" <<'REMOTE'
set -u
export PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$HOME/.opencode/bin:$HOME/.codex/bin:$PATH"

printf '\nRemote machine\n'
printf '  Name:    %s\n' "$(scutil --get ComputerName 2>/dev/null || hostname)"
printf '  macOS:   %s\n' "$(sw_vers -productVersion 2>/dev/null || printf unknown)"
printf '  Chip:    %s\n' "$(uname -m)"
printf '  Shell:   %s\n' "${SHELL:-unknown}"
printf '  Disk:    %s\n' "$(df -h "$HOME" | awk 'NR == 2 { print $4 " free" }')"

printf '\nAgents\n'
if command -v codex >/dev/null 2>&1; then
  printf '  Codex:   %s\n' "$(codex --version 2>/dev/null)"
  if codex login status >/dev/null 2>&1; then
    printf '  Auth:    ready\n'
  else
    printf '  Auth:    sign-in required\n'
  fi
else
  printf '  Codex:   not installed\n'
fi

if command -v opencode >/dev/null 2>&1; then
  printf '  OpenCode: %s\n' "$(opencode --version 2>/dev/null)"
else
  printf '  OpenCode: not installed\n'
fi

printf '\nPower\n'
if command -v pmset >/dev/null 2>&1; then
  pmset -g custom 2>/dev/null | awk '
    /AC Power/ { ac = 1; next }
    ac && / sleep / { print "  AC sleep:" $2 " minutes"; exit }
  '
fi
if [ -f "$HOME/.airlift/caffeinate.pid" ]; then
  caffeinate_pid="$(cat "$HOME/.airlift/caffeinate.pid" 2>/dev/null || true)"
  if [ -n "$caffeinate_pid" ] && kill -0 "$caffeinate_pid" 2>/dev/null; then
    printf '  Airlift: keep-awake active on AC power\n'
  fi
fi
REMOTE

  say ""
  say "Security: SSH key only, agent forwarding disabled, no public app-server port."
}

config_cmd() {
  load_config
  cat <<EOF
Alias:        $AIRLIFT_ALIAS
Target:       $AIRLIFT_TARGET
Project:      $AIRLIFT_PROJECT
Local port:   $AIRLIFT_LOCAL_PORT
Remote port:  $AIRLIFT_REMOTE_PORT
Config file:  $CONFIG_FILE
SSH key:      $KEY_FILE
EOF
}

main() {
  local command="${1:-help}"
  if [ "$#" -gt 0 ]; then
    shift
  fi

  case "$command" in
    setup) setup_cmd "$@" ;;
    codex|open) codex_cmd "$@" ;;
    web) web_cmd "$@" ;;
    clone) clone_cmd "$@" ;;
    login) login_cmd "$@" ;;
    shell|ssh) shell_cmd "$@" ;;
    awake) awake_cmd "$@" ;;
    sleep) sleep_cmd "$@" ;;
    stop) stop_cmd "$@" ;;
    doctor) doctor_cmd "$@" ;;
    config) config_cmd "$@" ;;
    version|--version|-v) say "airlift $VERSION" ;;
    help|--help|-h) usage ;;
    *) usage; die "Unknown command: $command" ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
