#!/bin/bash

set -euo pipefail

VERSION="0.5.0"
# Minimum free disk on the Air before cloning a repository and building is safe.
MIN_DISK_GB="${AIRLIFT_MIN_DISK_GB:-25}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/airlift"
CONFIG_FILE="$CONFIG_DIR/config"
KEY_FILE="$HOME/.ssh/airlift_ed25519"
SSH_CONFIG="$HOME/.ssh/config"

if [ -t 1 ]; then
  BOLD=$'\033[1m'
  DIM=$'\033[2m'
  GREEN=$'\033[32m'
  YELLOW=$'\033[33m'
  RED=$'\033[31m'
  CYAN=$'\033[36m'
  RESET=$'\033[0m'
else
  BOLD=""
  DIM=""
  GREEN=""
  YELLOW=""
  RED=""
  CYAN=""
  RESET=""
fi

say() {
  printf '%s\n' "$*"
}

info() {
  printf '%s●%s %s\n' "$CYAN" "$RESET" "$*"
}

ok() {
  printf '%s✓%s %s\n' "$GREEN" "$RESET" "$*"
}

warn() {
  printf '%s!%s %s\n' "$YELLOW" "$RESET" "$*" >&2
}

die() {
  printf '%sError:%s %s\n' "$RED" "$RESET" "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Airlift — run engineering agents on a spare Mac over SSH.

Usage:
  airlift setup <user@mac-host> [--alias spare-air] [--install cockpit|codex|claude|none] [--no-awake]
  airlift open [remote-project] [--local-port 3400] [--remote-port 3400]
  airlift model [model] [--effort xhigh] [--thinking off]   Default model for new sessions
  airlift clone <git-url> [remote-directory]
  airlift login [codex|claude]
  airlift shell
  airlift awake
  airlift sleep
  airlift stop                     Close the Pro → Air tunnel; agents keep running
  airlift shutdown                 Stop the cockpit on the Air
  airlift doctor
  airlift config
  airlift version

Fast path:
  airlift setup dylan@Dylans-MacBook-Air.local
  airlift open '~/Developer/my-project'
EOF
}

require() {
  command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

shell_quote() {
  local value="$1"
  printf "'%s'" "$(printf '%s' "$value" | sed "s/'/'\\\\''/g")"
}

validate_alias() {
  case "$1" in
    ""|*[!A-Za-z0-9._-]*)
      die "SSH alias may only contain letters, numbers, dots, underscores, and hyphens."
      ;;
  esac
}

validate_port() {
  case "$1" in
    ""|*[!0-9]*) die "Invalid port: $1" ;;
  esac
  [ "$1" -ge 1024 ] && [ "$1" -le 65535 ] || die "Port must be between 1024 and 65535."
}

load_config() {
  [ -f "$CONFIG_FILE" ] || die "Airlift is not paired yet. Run: airlift setup user@mac-host"
  # The file is generated by Airlift, owned by the current user, and chmod 600.
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
  if [ "${AIRLIFT_CONFIG_VERSION:-1}" -lt 2 ]; then
    case "${AIRLIFT_PROJECT:-~}" in
      "$HOME") AIRLIFT_PROJECT="~" ;;
      "$HOME/"*) AIRLIFT_PROJECT="~/${AIRLIFT_PROJECT#"$HOME/"}" ;;
    esac
  fi
  AIRLIFT_LOCAL_PORT="${AIRLIFT_LOCAL_PORT:-3400}"
  AIRLIFT_REMOTE_PORT="${AIRLIFT_REMOTE_PORT:-3400}"
  AIRLIFT_PROJECT="${AIRLIFT_PROJECT:-~}"
  validate_alias "$AIRLIFT_ALIAS"
}

save_config() {
  mkdir -p "$CONFIG_DIR"
  chmod 700 "$CONFIG_DIR"
  umask 077
  local temp
  temp="$(mktemp "$CONFIG_DIR/config.XXXXXX")"
  {
    printf 'AIRLIFT_CONFIG_VERSION=%s\n' "$(shell_quote "2")"
    printf 'AIRLIFT_ALIAS=%s\n' "$(shell_quote "$AIRLIFT_ALIAS")"
    printf 'AIRLIFT_TARGET=%s\n' "$(shell_quote "$AIRLIFT_TARGET")"
    printf 'AIRLIFT_LOCAL_PORT=%s\n' "$(shell_quote "${AIRLIFT_LOCAL_PORT:-3400}")"
    printf 'AIRLIFT_REMOTE_PORT=%s\n' "$(shell_quote "${AIRLIFT_REMOTE_PORT:-3400}")"
    printf 'AIRLIFT_PROJECT=%s\n' "$(shell_quote "${AIRLIFT_PROJECT:-~}")"
  } >"$temp"
  chmod 600 "$temp"
  mv "$temp" "$CONFIG_FILE"
}

ssh_socket() {
  printf '/tmp/airlift-%s-%s.sock' "$UID" "$AIRLIFT_ALIAS"
}

remote_path_prefix() {
  printf '%s' 'export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.codex/bin:$PATH";'
}

add_ssh_config() {
  local alias="$1"
  local hostname="$2"
  local username="$3"
  local start="# >>> airlift:${alias} >>>"
  local end="# <<< airlift:${alias} <<<"
  local temp

  mkdir -p "$HOME/.ssh"
  chmod 700 "$HOME/.ssh"
  touch "$SSH_CONFIG"
  chmod 600 "$SSH_CONFIG"
  cp "$SSH_CONFIG" "$SSH_CONFIG.airlift.bak"
  temp="$(mktemp "$HOME/.ssh/config.XXXXXX")"

  awk -v start="$start" -v end="$end" '
    $0 == start { skipping = 1; next }
    $0 == end { skipping = 0; next }
    !skipping { print }
  ' "$SSH_CONFIG" >"$temp"

  cat >>"$temp" <<EOF

$start
Host $alias
  HostName $hostname
  User $username
  IdentityFile $KEY_FILE
  IdentitiesOnly yes
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 30
  ServerAliveCountMax 3
  TCPKeepAlive yes
  ForwardAgent no
$end
EOF

  chmod 600 "$temp"
  mv "$temp" "$SSH_CONFIG"
}

remote_install() {
  local install_mode="$1"
  local quoted_mode
  quoted_mode="$(shell_quote "$install_mode")"

  info "Checking the Air and installing the remote cockpit…"
  ssh "$AIRLIFT_ALIAS" "AIRLIFT_INSTALL=$quoted_mode bash -s" <<'REMOTE'
set -eu

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.codex/bin:$PATH"
mkdir -p "$HOME/.airlift/logs" "$HOME/.airlift/runtime" "$HOME/.local/bin"

add_login_path() {
  profile="$1"
  marker="# Added by Airlift"
  line='export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.codex/bin:$PATH"'
  touch "$profile"
  if ! grep -F "$marker" "$profile" >/dev/null 2>&1; then
    {
      printf '\n%s\n' "$marker"
      printf '%s\n' "$line"
    } >>"$profile"
  fi
}

add_login_path "$HOME/.zprofile"
add_login_path "$HOME/.bash_profile"

ensure_node() {
  node_major=0
  if command -v node >/dev/null 2>&1; then
    node_major="$(node -p 'Number(process.versions.node.split(".")[0])' 2>/dev/null || printf 0)"
  fi
  if [ "$node_major" -ge 22 ] && command -v npm >/dev/null 2>&1; then
    return
  fi

  command -v curl >/dev/null 2>&1 || {
    printf 'curl is required to install the user-local Node.js runtime.\n' >&2
    exit 1
  }
  command -v shasum >/dev/null 2>&1 || {
    printf 'shasum is required to verify the Node.js download.\n' >&2
    exit 1
  }

  printf 'Installing a verified user-local Node.js LTS runtime on the Air…\n'
  node_version="$(
    curl -fsSL https://nodejs.org/dist/index.tab |
      awk -F '\t' '
        NR > 1 {
          version = $1
          sub(/^v/, "", version)
          split(version, parts, ".")
          if (parts[1] >= 22 && $10 != "-" && $10 != "") {
            print $1
            exit
          }
        }
      '
  )"
  [ -n "$node_version" ] || {
    printf 'Could not resolve a supported Node.js LTS release.\n' >&2
    exit 1
  }

  case "$(uname -m)" in
    arm64) node_arch="arm64" ;;
    x86_64) node_arch="x64" ;;
    *)
      printf 'Unsupported Mac architecture: %s\n' "$(uname -m)" >&2
      exit 1
      ;;
  esac

  archive="node-${node_version}-darwin-${node_arch}.tar.gz"
  runtime_dir="$HOME/.airlift/runtime/node-${node_version}-darwin-${node_arch}"
  if [ ! -x "$runtime_dir/bin/node" ]; then
    temp_dir="$(mktemp -d "$HOME/.airlift/node-install.XXXXXX")"
    curl -fsSL "https://nodejs.org/dist/${node_version}/${archive}" -o "$temp_dir/$archive"
    expected="$(
      curl -fsSL "https://nodejs.org/dist/${node_version}/SHASUMS256.txt" |
        awk -v archive="$archive" '$2 == archive { print $1; exit }'
    )"
    [ -n "$expected" ] || {
      printf 'Could not find the Node.js checksum.\n' >&2
      exit 1
    }
    actual="$(shasum -a 256 "$temp_dir/$archive" | awk '{ print $1 }')"
    [ "$actual" = "$expected" ] || {
      printf 'Node.js checksum verification failed.\n' >&2
      exit 1
    }
    tar -xzf "$temp_dir/$archive" -C "$HOME/.airlift/runtime"
    rm -rf "$temp_dir"
  fi

  ln -sf "$runtime_dir/bin/node" "$HOME/.local/bin/node"
  ln -sf "$runtime_dir/bin/npm" "$HOME/.local/bin/npm"
  ln -sf "$runtime_dir/bin/npx" "$HOME/.local/bin/npx"
  hash -r
}

install_npm_tool() {
  command_name="$1"
  package_name="$2"
  display_name="$3"

  if command -v "$command_name" >/dev/null 2>&1; then
    return
  fi

  ensure_node
  printf 'Installing %s on the Air…\n' "$display_name"
  npm install -g --prefix "$HOME/.local" "$package_name"
  hash -r
}

install_codex() {
  install_npm_tool codex @openai/codex "Codex CLI"
}

install_claude() {
  install_npm_tool claude @anthropic-ai/claude-code "Claude Code"
}

install_cockpit() {
  install_npm_tool yepanywhere yepanywhere "Yep Anywhere"
}

case "$AIRLIFT_INSTALL" in
  cockpit|all)
    install_codex
    install_claude
    install_cockpit
    ;;
  codex)
    install_codex
    ;;
  claude)
    install_claude
    ;;
  none)
    ;;
  *)
    printf 'Unknown install mode: %s\n' "$AIRLIFT_INSTALL" >&2
    exit 1
    ;;
esac

printf 'Remote: %s · %s · %s\n' "$(scutil --get ComputerName 2>/dev/null || hostname)" "$(uname -m)" "$(sw_vers -productVersion 2>/dev/null || uname -r)"
if command -v codex >/dev/null 2>&1; then
  codex --version
fi
if command -v claude >/dev/null 2>&1; then
  claude --version
fi
if command -v yepanywhere >/dev/null 2>&1; then
  printf 'yepanywhere %s\n' "$(yepanywhere --version)"
fi
REMOTE
}

setup_cmd() {
  require ssh
  require ssh-keygen
  require ssh-copy-id

  [ "$#" -ge 1 ] || die "Usage: airlift setup <user@mac-host> [--alias spare-air] [--install cockpit|codex|claude|none] [--no-awake]"

  local target="$1"
  shift
  local alias="spare-air"
  local install_mode="cockpit"
  local keep_awake="1"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --alias)
        [ "$#" -ge 2 ] || die "--alias needs a value."
        alias="$2"
        shift 2
        ;;
      --install)
        [ "$#" -ge 2 ] || die "--install needs a value."
        install_mode="$2"
        shift 2
        ;;
      --no-awake)
        keep_awake="0"
        shift
        ;;
      *)
        die "Unknown setup option: $1"
        ;;
    esac
  done

  validate_alias "$alias"
  case "$install_mode" in cockpit|all|codex|claude|none) ;; *) die "Install mode must be cockpit, codex, claude, or none." ;; esac

  local username hostname
  if [[ "$target" == *"@"* ]]; then
    username="${target%@*}"
    hostname="${target#*@}"
  else
    username="$USER"
    hostname="$target"
    target="$username@$hostname"
  fi

  case "$username" in ""|*[!A-Za-z0-9._-]*) die "Invalid SSH username: $username" ;; esac
  case "$hostname" in ""|*[!A-Za-z0-9._:-]*) die "Invalid SSH hostname: $hostname" ;; esac

  say ""
  say "${BOLD}Airlift setup${RESET}"
  say "${DIM}MacBook Pro → $target${RESET}"
  say ""

  if [ ! -f "$KEY_FILE" ]; then
    info "Creating a dedicated SSH key at $KEY_FILE"
    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    ssh-keygen -q -t ed25519 -f "$KEY_FILE" -N "" -C "airlift@${HOSTNAME:-$(hostname)}"
    chmod 600 "$KEY_FILE"
    chmod 644 "$KEY_FILE.pub"
  else
    ok "Dedicated SSH key already exists."
  fi

  add_ssh_config "$alias" "$hostname" "$username"
  ok "Added the private SSH connection '$alias'."

  if ! ssh -o BatchMode=yes -o ConnectTimeout=6 "$alias" true >/dev/null 2>&1; then
    warn "One Mac password prompt may appear to authorize Dylan's SSH key."
    if ! ssh-copy-id -i "$KEY_FILE.pub" -o StrictHostKeyChecking=accept-new "$target"; then
      say ""
      warn "Could not reach the Air."
      say "On the Air, enable: System Settings → General → Sharing → Remote Login"
      say "Allow access for the '$username' user, then rerun the setup command."
      exit 1
    fi
  fi

  ssh -o BatchMode=yes -o ConnectTimeout=8 "$alias" true >/dev/null
  ok "Passwordless SSH is working."

  AIRLIFT_ALIAS="$alias"
  AIRLIFT_TARGET="$target"
  AIRLIFT_LOCAL_PORT="3400"
  AIRLIFT_REMOTE_PORT="3400"
  AIRLIFT_PROJECT="~"
  save_config

  remote_install "$install_mode"

  if [ "$install_mode" = "cockpit" ] || [ "$install_mode" = "all" ] || [ "$install_mode" = "codex" ]; then
    if ! ssh "$AIRLIFT_ALIAS" "$(remote_path_prefix) codex login status" >/dev/null 2>&1; then
      say ""
      info "Codex needs a one-time sign-in on the Air."
      ssh -t "$AIRLIFT_ALIAS" "$(remote_path_prefix) codex login --device-auth"
    else
      ok "Codex is authenticated on the Air."
    fi
  fi

  if [ "$install_mode" = "cockpit" ] || [ "$install_mode" = "all" ] || [ "$install_mode" = "claude" ]; then
    if ! ssh "$AIRLIFT_ALIAS" "$(remote_path_prefix) claude auth status" >/dev/null 2>&1; then
      say ""
      info "Claude Code needs a one-time sign-in on the Air."
      ssh -t "$AIRLIFT_ALIAS" "$(remote_path_prefix) claude auth login"
    else
      ok "Claude Code is authenticated on the Air."
    fi
  fi

  if [ "$keep_awake" = "1" ]; then
    awake_cmd
  fi

  say ""
  ok "The Macs are paired."
  say ""
  say "Open the Codex + Claude cockpit:"
  say "  ${BOLD}./airlift open '~/Developer/your-project'${RESET}"
}

tunnel_watchdog_script() { printf '%s/tunnel-watchdog.sh' "$CONFIG_DIR"; }
tunnel_watchdog_pid_file() { printf '%s/tunnel-watchdog.pid' "$CONFIG_DIR"; }
tunnel_watchdog_stop_file() { printf '%s/tunnel-watchdog.stop' "$CONFIG_DIR"; }

# Generate the Pro-side watchdog that re-establishes the SSH forward when the
# master dies (Air slept, Wi-Fi blipped). Split out so it can be unit-tested
# without spawning the loop. Args: socket local_port remote_port alias.
write_tunnel_watchdog() {
  local socket="$1" local_port="$2" remote_port="$3" alias="$4"
  local script stop
  script="$(tunnel_watchdog_script)"
  stop="$(tunnel_watchdog_stop_file)"
  mkdir -p "$CONFIG_DIR"
  chmod 700 "$CONFIG_DIR"
  umask 077
  cat >"$script" <<EOF
#!/bin/bash
set -u
socket=$(shell_quote "$socket")
stop_file=$(shell_quote "$stop")
alias=$(shell_quote "$alias")
interval="\${AIRLIFT_TUNNEL_CHECK_INTERVAL:-15}"

reconnect() {
  rm -f "\$socket"
  ssh -fN -M -S "\$socket" \\
    -o ExitOnForwardFailure=yes \\
    -o ControlPersist=no \\
    -o ConnectTimeout=8 \\
    -L $(shell_quote "$local_port"):127.0.0.1:$(shell_quote "$remote_port") \\
    "\$alias" >/dev/null 2>&1 || true
}

while :; do
  [ -f "\$stop_file" ] && break
  if ! ssh -S "\$socket" -O check "\$alias" >/dev/null 2>&1; then
    reconnect
  fi
  sleep "\$interval"
done
rm -f "\$socket"
EOF
  chmod 700 "$script"
}

start_tunnel_watchdog() {
  # Args: socket local_port remote_port. Opt out with AIRLIFT_TUNNEL_KEEPALIVE=0.
  [ "${AIRLIFT_TUNNEL_KEEPALIVE:-1}" = "1" ] || return 0
  stop_tunnel_watchdog
  local script pidf stop
  script="$(tunnel_watchdog_script)"
  pidf="$(tunnel_watchdog_pid_file)"
  stop="$(tunnel_watchdog_stop_file)"
  rm -f "$stop"
  write_tunnel_watchdog "$1" "$2" "$3" "$AIRLIFT_ALIAS"
  mkdir -p "$CONFIG_DIR/logs"
  nohup /bin/bash "$script" >>"$CONFIG_DIR/logs/tunnel-watchdog.log" 2>&1 </dev/null &
  printf '%s\n' "$!" >"$pidf"
}

stop_tunnel_watchdog() {
  local pidf stop pid
  pidf="$(tunnel_watchdog_pid_file)"
  stop="$(tunnel_watchdog_stop_file)"
  : >"$stop" 2>/dev/null || true
  if [ -f "$pidf" ]; then
    pid="$(cat "$pidf" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      case "$(ps -p "$pid" -o command= 2>/dev/null || true)" in
        *tunnel-watchdog.sh*) kill "$pid" 2>/dev/null || true ;;
      esac
    fi
    rm -f "$pidf"
  fi
  rm -f "$stop" 2>/dev/null || true
}

stop_tunnel_only() {
  stop_tunnel_watchdog
  local socket
  socket="$(ssh_socket)"
  if [ -S "$socket" ]; then
    ssh -S "$socket" -O exit "$AIRLIFT_ALIAS" >/dev/null 2>&1 || true
    rm -f "$socket"
  fi
}

stop_cmd() {
  load_config
  stop_tunnel_only
  ok "Closed the SSH tunnel. Running agents remain on the Air."
}

shutdown_cmd() {
  load_config
  stop_tunnel_only
  local quoted_port
  quoted_port="$(shell_quote "$AIRLIFT_REMOTE_PORT")"
  ssh "$AIRLIFT_ALIAS" "AIRLIFT_PORT=$quoted_port bash -s" <<'REMOTE' >/dev/null 2>&1 || true
set -eu
pid_file="$HOME/.airlift/yep-$AIRLIFT_PORT.pid"
if [ -f "$pid_file" ]; then
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    command_line="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    case "$command_line" in
      *yepanywhere*) kill "$pid" 2>/dev/null || true ;;
    esac
  fi
  rm -f "$pid_file"
fi
REMOTE
  ok "Stopped the cockpit on the Air."
}

cockpit_cmd() {
  load_config
  require ssh
  require open

  local project="$AIRLIFT_PROJECT"
  local local_port="$AIRLIFT_LOCAL_PORT"
  local remote_port="$AIRLIFT_REMOTE_PORT"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --local-port)
        [ "$#" -ge 2 ] || die "--local-port needs a value."
        local_port="$2"
        shift 2
        ;;
      --remote-port)
        [ "$#" -ge 2 ] || die "--remote-port needs a value."
        remote_port="$2"
        shift 2
        ;;
      -*)
        die "Unknown cockpit option: $1"
        ;;
      *)
        project="$1"
        shift
        ;;
    esac
  done

  validate_port "$local_port"
  validate_port "$remote_port"

  AIRLIFT_LOCAL_PORT="$local_port"
  AIRLIFT_REMOTE_PORT="$remote_port"
  AIRLIFT_PROJECT="$project"
  save_config

  if ! ssh "$AIRLIFT_ALIAS" "$(remote_path_prefix) command -v yepanywhere >/dev/null" >/dev/null 2>&1; then
    die "Yep Anywhere is not installed on the Air. Rerun: airlift setup $AIRLIFT_TARGET"
  fi

  stop_tunnel_only

  if command -v lsof >/dev/null 2>&1 && lsof -nP -iTCP:"$local_port" -sTCP:LISTEN >/dev/null 2>&1; then
    die "Local port $local_port is already in use. Try: airlift open --local-port 3401"
  fi

  local quoted_project quoted_port resolved_project remote_home
  quoted_project="$(shell_quote "$project")"
  quoted_port="$(shell_quote "$remote_port")"
  case "$project" in
    "~")
      remote_home="$(ssh "$AIRLIFT_ALIAS" 'printf %s "$HOME"')"
      resolved_project="$remote_home"
      ;;
    "~/"*)
      remote_home="$(ssh "$AIRLIFT_ALIAS" 'printf %s "$HOME"')"
      resolved_project="$remote_home/${project#\~/}"
      ;;
    *)
      resolved_project="$project"
      ;;
  esac

  info "Starting the Codex + Claude cockpit on the Air…"
  ssh "$AIRLIFT_ALIAS" "AIRLIFT_PROJECT=$quoted_project AIRLIFT_PORT=$quoted_port bash -s" <<'REMOTE'
set -eu
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.codex/bin:$PATH"

project="$AIRLIFT_PROJECT"
case "$project" in
  "~") project="$HOME" ;;
  "~/"*) project="$HOME/${project#\~/}" ;;
esac

mkdir -p "$HOME/.airlift/logs"
pid_file="$HOME/.airlift/yep-$AIRLIFT_PORT.pid"
log_file="$HOME/.airlift/logs/yep-$AIRLIFT_PORT.log"
running=0

if [ -f "$pid_file" ]; then
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    command_line="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    case "$command_line" in
      *yepanywhere*) running=1 ;;
    esac
  fi
fi

if [ "$running" -ne 1 ]; then
  if curl -fsS "http://127.0.0.1:$AIRLIFT_PORT/api/version" 2>/dev/null |
    grep -F '"current"' >/dev/null 2>&1; then
    running=1
  else
    YEP_BIN="$(command -v yepanywhere)"
    nohup "$YEP_BIN" \
      --host 127.0.0.1 \
      --port "$AIRLIFT_PORT" \
      >"$log_file" 2>&1 </dev/null &
    pid="$!"
    printf '%s\n' "$pid" >"$pid_file"
  fi
fi

ready=0
attempt=0
while [ "$attempt" -lt 80 ]; do
  if curl -fsS "http://127.0.0.1:$AIRLIFT_PORT/api/version" 2>/dev/null |
    grep -F '"current"' >/dev/null 2>&1; then
    ready=1
    break
  fi
  if [ "$running" -ne 1 ] && ! kill -0 "$pid" 2>/dev/null; then
    break
  fi
  attempt=$((attempt + 1))
  sleep 0.25
done

if [ "$ready" -ne 1 ]; then
  tail -n 30 "$log_file" >&2 || true
  exit 1
fi

if [ "$project" != "$HOME" ]; then
  [ -d "$project" ] || {
    printf 'Remote project does not exist: %s\n' "$project" >&2
    exit 1
  }
  payload="$(node -e 'process.stdout.write(JSON.stringify({path: process.argv[1]}))' "$project")"
  curl -fsS \
    -X POST \
    -H 'Content-Type: application/json' \
    -H 'X-Yep-Anywhere: true' \
    --data "$payload" \
    "http://127.0.0.1:$AIRLIFT_PORT/api/projects" \
    >/dev/null 2>&1 || true
fi
REMOTE

  local socket
  socket="$(ssh_socket)"
  rm -f "$socket"
  ssh -fN -M -S "$socket" \
    -o ExitOnForwardFailure=yes \
    -o ControlPersist=no \
    -o ConnectTimeout=8 \
    -L "$local_port:127.0.0.1:$remote_port" \
    "$AIRLIFT_ALIAS"

  ok "Private tunnel is live: MacBook Pro → MacBook Air"

  # Keep the tunnel up across Air sleeps / Wi-Fi drops, and make sure the Air is
  # holding a keep-awake assertion (idempotent: a no-op if already awake).
  start_tunnel_watchdog "$socket" "$local_port" "$remote_port"
  keepawake_ensure quiet
  local url="http://127.0.0.1:$local_port"
  if [ "$project" != "~" ]; then
    local project_id
    project_id="$(
      printf '%s' "$resolved_project" |
        openssl base64 -A |
        tr '+/' '-_' |
        tr -d '='
    )"
    url="$url/new-session?projectId=$project_id"
  fi
  open "$url"
  say ""
  say "The UI is on this Mac; Codex, Claude Code, files, and commands are on the Air."
  say "Closing the browser does not stop active work."
}

