stop_pid_file() {
  pid_file="$1"
  pattern="$2"
  [ -f "$pid_file" ] || return 0
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    command_line="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    case "$command_line" in
      *"$pattern"*) kill "$pid" 2>/dev/null || true ;;
    esac
  fi
  rm -f "$pid_file"
}

# Stop the supervisor first so it does not restart the assertion we are killing.
stop_pid_file "$HOME/.airlift/keepawake.pid" keepawake.sh
stop_pid_file "$HOME/.airlift/caffeinate.pid" caffeinate
rm -f "$stop_file"
REMOTE
  ok "Released Airlift's keep-awake assertion."
}

