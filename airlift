keepawake_ensure() {
  # Ensure the Air holds a supervised keep-awake assertion. Prefers a launchd
  # LaunchAgent (survives reboot/logout); falls back to a nohup supervisor.
  # Idempotent, safe to call on every `open`. Pass "quiet" to suppress chatter.
  local quiet="${1:-}"
  local use_launchd quoted_launchd method tmp
  use_launchd="${AIRLIFT_USE_LAUNCHD:-1}"
  # Capture the remote output via a temp file, not $(ssh … <<HEREDOC): bash 3.2
  # (macOS /bin/bash) mis-parses a here-doc nested inside a command substitution.
  quoted_launchd="$(shell_quote "$use_launchd")"
  tmp="$(mktemp "${TMPDIR:-/tmp}/airlift-awake.XXXXXX")"
  ssh "$AIRLIFT_ALIAS" "AIRLIFT_USE_LAUNCHD=$quoted_launchd bash -s" <<'REMOTE' >"$tmp" 2>/dev/null || true
set -eu
mkdir -p "$HOME/.airlift/logs" "$HOME/Library/LaunchAgents"
label="com.airlift.keepawake"
plist="$HOME/Library/LaunchAgents/$label.plist"
script_file="$HOME/.airlift/keepawake.sh"
stop_file="$HOME/.airlift/keepawake.stop"
supervisor_pid_file="$HOME/.airlift/keepawake.pid"

# The supervisor respawns `caffeinate -s` if it exits, and records its own pid so
# doctor can see it whether launchd or nohup started it. A bare caffeinate is a
# single point of failure; supervising it means a dead assertion self-heals.
cat >"$script_file" <<'SUPERVISOR'
#!/bin/bash
set -u

stop_file="$HOME/.airlift/keepawake.stop"
caffeinate_pid_file="$HOME/.airlift/caffeinate.pid"
caffeinate_pid=""

printf '%s\n' "$$" >"$HOME/.airlift/keepawake.pid"

shut_down() {
  if [ -n "$caffeinate_pid" ]; then
    kill "$caffeinate_pid" 2>/dev/null || true
  fi
  rm -f "$caffeinate_pid_file"
  exit 0
}

trap shut_down TERM INT

if [ ! -x /usr/bin/caffeinate ]; then
  printf 'caffeinate not found; keep-awake cannot run on this host\n' >&2
  exit 1
fi

while :; do
  [ -f "$stop_file" ] && break
  /usr/bin/caffeinate -s &
  caffeinate_pid=$!
  printf '%s\n' "$caffeinate_pid" >"$caffeinate_pid_file"
  wait "$caffeinate_pid" 2>/dev/null || true
  caffeinate_pid=""
  [ -f "$stop_file" ] && break
  printf '%s keep-awake assertion exited; restarting\n' \
    "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  sleep 2
done

rm -f "$caffeinate_pid_file"
SUPERVISOR

chmod 700 "$script_file"
rm -f "$stop_file"
uid="$(id -u)"

# Prefer launchd so keep-awake survives a reboot/logout, not just a crash.
if [ "${AIRLIFT_USE_LAUNCHD:-1}" = "1" ] && command -v launchctl >/dev/null 2>&1; then
  cat >"$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$script_file</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>$HOME/.airlift/logs/keepawake.log</string>
  <key>StandardErrorPath</key><string>$HOME/.airlift/logs/keepawake.log</string>
</dict>
</plist>
PLIST
  if launchctl print "gui/$uid/$label" >/dev/null 2>&1; then
    launchctl kickstart "gui/$uid/$label" >/dev/null 2>&1 || true
    printf 'launchd\n'
    exit 0
  fi
  launchctl bootout "gui/$uid/$label" >/dev/null 2>&1 || true
  if launchctl bootstrap "gui/$uid" "$plist" >/dev/null 2>&1; then
    printf 'launchd\n'
    exit 0
  fi
  # Bootstrap failed (e.g. no active GUI session); fall through to nohup.
fi

if [ -f "$supervisor_pid_file" ]; then
  pid="$(cat "$supervisor_pid_file" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    case "$(ps -p "$pid" -o command= 2>/dev/null || true)" in
      *keepawake.sh*) printf 'nohup\n'; exit 0 ;;
    esac
  fi
fi
nohup /bin/bash "$script_file" >>"$HOME/.airlift/logs/keepawake.log" 2>&1 </dev/null &
printf '%s\n' "$!" >"$supervisor_pid_file"
printf 'nohup\n'
REMOTE
  method="$(cat "$tmp" 2>/dev/null || true)"
  rm -f "$tmp"

  [ "$quiet" = "quiet" ] && return 0

  case "$method" in
    launchd)
      ok "The Air will stay awake on AC power; keep-awake auto-starts after a reboot (launchd)."
      ;;
    nohup)
      ok "The Air will stay awake while connected to AC power."
      say "${DIM}Supervised, but not registered with launchd, so it won't restart after an Air reboot.${RESET}"
      ;;
    *)
      warn "Could not confirm keep-awake started. Check: airlift doctor"
      ;;
  esac
  say "${DIM}Verify any time with: airlift doctor${RESET}"
}

