#!/bin/bash

set -euo pipefail

VERSION="0.4.2"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/airlift"
CONFIG_FILE="$CONFIG_DIR/config"
NODES_DIR="$CONFIG_DIR/nodes"
LOCKS_DIR="$CONFIG_DIR/locks"
REAL_BINARIES_FILE="$CONFIG_DIR/real-binaries"
FORCE_LOCAL_FILE="$CONFIG_DIR/force-local"
ACTIVE_TUNNEL_FILE="$CONFIG_DIR/active-tunnel"
EVENTS_FILE="$CONFIG_DIR/events.log"
DASHBOARD_PORT="3410"
KEY_FILE="$HOME/.ssh/airlift_ed25519"
SSH_CONFIG="$HOME/.ssh/config"

if [ -t 1 ]; then
  BOLD=$'\033[1m'
  DIM=$'\033[2m'
  GREEN=$'\033[32m'
  YELLOW=$'\033[33m'
  RED=$'\033[31m'
  CYAN=$'\033[36m'
  RESET=$'\033[0m'
else
  BOLD=""
  DIM=""
  GREEN=""
  YELLOW=""
  RED=""
  CYAN=""
  RESET=""
fi

say() {
  printf '%s\n' "$*"
}

info() {
  printf '%s●%s %s\n' "$CYAN" "$RESET" "$*"
}

ok() {
  printf '%s✓%s %s\n' "$GREEN" "$RESET" "$*"
}

warn() {
  printf '%s!%s %s\n' "$YELLOW" "$RESET" "$*" >&2
}

die() {
  printf '%sError:%s %s\n' "$RED" "$RESET" "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Airlift — route engineering agents across a private Mac pool over SSH.

Usage:
  airlift setup <user@mac-host> [options]       Pair the first worker (compatible with v0.2)
  airlift join <user@mac-host> [options]        Add another Mac to the pool
  airlift nodes [--json]                         Show live pool load and availability
  airlift dashboard [--port N]                   Open the local pool board in a browser
  airlift run [options] <message>                Route one task to the least-used Mac
  airlift exec [options] -- <agent-args>         Hop claude/codex off this Mac
  airlift local on|off|status                    Force agents to stay on this Mac
  airlift open [remote-project] [options]        Open a cockpit on the least-used Mac
  airlift clone <git-url> [directory] [options]  Clone on one worker or the whole pool
  airlift login [codex|claude] [--worker name]
  airlift shell [worker]
  airlift awake [--worker name]
  airlift sleep [--worker name]
  airlift metrics status|install                 Install/check CPU temp and GPU sampler
  airlift stop                                   Close the active private tunnel
  airlift shutdown [--worker name]               Stop one worker's cockpit
  airlift doctor [--worker name]
  airlift config
  airlift version

Pool options:
  --alias NAME                 Stable name for a worker
  --slots auto|N              Concurrent capacity (default: auto from CPU count)
  --transport auto|lan|tailscale
  --worker auto|NAME|all      Route automatically, pin a worker, or target all

Examples:
  airlift setup dylan@Dylans-MacBook-Air.local
  airlift join ojas@beefy-mac --alias beefy --slots 6 --transport tailscale
  airlift run --project '~/Developer/my-project' 'Fix the failing unit test'
  claude -p 'review this'   # after install-controller: hops automatically
  airlift dashboard
  airlift open '~/Developer/my-project'
EOF
}

require() {
  command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

shell_quote() {
  local value="$1"
  printf "'%s'" "$(printf '%s' "$value" | sed "s/'/'\\\\''/g")"
}

validate_alias() {
  case "$1" in
    ""|*[!A-Za-z0-9._-]*)
      die "SSH alias may only contain letters, numbers, dots, underscores, and hyphens."
      ;;
  esac
}

validate_port() {
  case "$1" in
    ""|*[!0-9]*) die "Invalid port: $1" ;;
  esac
  [ "$1" -ge 1024 ] && [ "$1" -le 65535 ] || die "Port must be between 1024 and 65535."
}

validate_slots() {
  case "$1" in
    auto) ;;
    ""|*[!0-9]*) die "Slots must be auto or a positive number." ;;
    *) [ "$1" -ge 1 ] || die "Slots must be at least 1." ;;
  esac
}

validate_transport() {
  case "$1" in
    auto|lan|tailscale) ;;
    *) die "Transport must be auto, lan, or tailscale." ;;
  esac
}

node_file() {
  printf '%s/%s' "$NODES_DIR" "$1"
}

save_node() {
  validate_alias "$AIRLIFT_ALIAS"
  validate_slots "${AIRLIFT_SLOTS:-auto}"
  validate_transport "${AIRLIFT_TRANSPORT:-auto}"
  mkdir -p "$NODES_DIR"
  chmod 700 "$CONFIG_DIR" "$NODES_DIR"
  umask 077
  local file temp
  file="$(node_file "$AIRLIFT_ALIAS")"
  temp="$(mktemp "$CONFIG_DIR/node.XXXXXX")"
  {
    printf 'AIRLIFT_NODE_CONFIG_VERSION=%s\n' "$(shell_quote "1")"
    printf 'AIRLIFT_ALIAS=%s\n' "$(shell_quote "$AIRLIFT_ALIAS")"
    printf 'AIRLIFT_TARGET=%s\n' "$(shell_quote "$AIRLIFT_TARGET")"
    printf 'AIRLIFT_SLOTS=%s\n' "$(shell_quote "${AIRLIFT_SLOTS:-auto}")"
    printf 'AIRLIFT_TRANSPORT=%s\n' "$(shell_quote "${AIRLIFT_TRANSPORT:-auto}")"
    printf 'AIRLIFT_HARDWARE_UUID=%s\n' "$(shell_quote "${AIRLIFT_HARDWARE_UUID:-}")"
  } >"$temp"
  chmod 600 "$temp"
  mv "$temp" "$file"
}

load_node() {
  local alias="$1"
  validate_alias "$alias"
  local file
  file="$(node_file "$alias")"
  [ -f "$file" ] || die "Unknown worker '$alias'. Run: airlift nodes"
  unset AIRLIFT_NODE_CONFIG_VERSION AIRLIFT_ALIAS AIRLIFT_TARGET AIRLIFT_SLOTS AIRLIFT_TRANSPORT AIRLIFT_HARDWARE_UUID
  # Node files are generated by Airlift, owned by the current user, and mode 600.
  # shellcheck disable=SC1090
  source "$file"
  AIRLIFT_SLOTS="${AIRLIFT_SLOTS:-auto}"
  AIRLIFT_TRANSPORT="${AIRLIFT_TRANSPORT:-auto}"
  AIRLIFT_HARDWARE_UUID="${AIRLIFT_HARDWARE_UUID:-}"
  validate_alias "$AIRLIFT_ALIAS"
  validate_slots "$AIRLIFT_SLOTS"
  validate_transport "$AIRLIFT_TRANSPORT"
}

list_node_aliases() {
  [ -d "$NODES_DIR" ] || return 0
  local file
  for file in "$NODES_DIR"/*; do
    [ -f "$file" ] || continue
    basename "$file"
  done | LC_ALL=C sort
}

load_config() {
  local required="${1:-required}"
  if [ ! -f "$CONFIG_FILE" ]; then
    [ "$required" = "optional" ] || die "Airlift is not paired yet. Run: airlift setup user@mac-host"
    AIRLIFT_LOCAL_PORT="${AIRLIFT_LOCAL_PORT:-3400}"
    AIRLIFT_REMOTE_PORT="${AIRLIFT_REMOTE_PORT:-3400}"
    AIRLIFT_PROJECT="${AIRLIFT_PROJECT:-~}"
    AIRLIFT_DEFAULT_NODE=""
    return 1
  fi
  # The file is generated by Airlift, owned by the current user, and chmod 600.
  # shellcheck disable=SC1090
  unset AIRLIFT_CONFIG_VERSION AIRLIFT_DEFAULT_NODE AIRLIFT_LOCAL_PORT AIRLIFT_REMOTE_PORT AIRLIFT_PROJECT AIRLIFT_ALIAS AIRLIFT_TARGET AIRLIFT_SLOTS AIRLIFT_TRANSPORT
  source "$CONFIG_FILE"
  local config_version="${AIRLIFT_CONFIG_VERSION:-1}"
  if [ "$config_version" -lt 2 ]; then
    case "${AIRLIFT_PROJECT:-~}" in
      "$HOME") AIRLIFT_PROJECT="~" ;;
      "$HOME/"*) AIRLIFT_PROJECT="~/${AIRLIFT_PROJECT#"$HOME/"}" ;;
    esac
  fi
  AIRLIFT_LOCAL_PORT="${AIRLIFT_LOCAL_PORT:-3400}"
  AIRLIFT_REMOTE_PORT="${AIRLIFT_REMOTE_PORT:-3400}"
  AIRLIFT_PROJECT="${AIRLIFT_PROJECT:-~}"
  AIRLIFT_DEFAULT_NODE="${AIRLIFT_DEFAULT_NODE:-${AIRLIFT_ALIAS:-}}"

  # Migrate the v0.2 single-worker config into the v0.3 node directory.
  if [ "$config_version" -lt 3 ] && [ -n "${AIRLIFT_ALIAS:-}" ]; then
    AIRLIFT_SLOTS="auto"
    AIRLIFT_TRANSPORT="auto"
    save_node
    AIRLIFT_CONFIG_VERSION="3"
    save_config
  fi

  if [ -z "$AIRLIFT_DEFAULT_NODE" ]; then
    [ "$required" = "optional" ] || die "No workers are configured. Run: airlift join user@mac-host"
    return 1
  fi
  validate_alias "$AIRLIFT_DEFAULT_NODE"
}

save_config() {
  mkdir -p "$CONFIG_DIR"
  chmod 700 "$CONFIG_DIR"
  umask 077
  local temp
  temp="$(mktemp "$CONFIG_DIR/config.XXXXXX")"
  {
    printf 'AIRLIFT_CONFIG_VERSION=%s\n' "$(shell_quote "3")"
    printf 'AIRLIFT_DEFAULT_NODE=%s\n' "$(shell_quote "$AIRLIFT_DEFAULT_NODE")"
    printf 'AIRLIFT_LOCAL_PORT=%s\n' "$(shell_quote "${AIRLIFT_LOCAL_PORT:-3400}")"
    printf 'AIRLIFT_REMOTE_PORT=%s\n' "$(shell_quote "${AIRLIFT_REMOTE_PORT:-3400}")"
    printf 'AIRLIFT_PROJECT=%s\n' "$(shell_quote "${AIRLIFT_PROJECT:-~}")"
  } >"$temp"
  chmod 600 "$temp"
  mv "$temp" "$CONFIG_FILE"
}

ssh_socket() {
  printf '/tmp/airlift-%s-%s.sock' "$UID" "$1"
}

remote_path_prefix() {
  printf '%s' 'export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.codex/bin:$PATH";'
}

add_ssh_config() {
  local alias="$1"
  local hostname="$2"
  local username="$3"
  local start="# >>> airlift:${alias} >>>"
  local end="# <<< airlift:${alias} <<<"
  local temp

  mkdir -p "$HOME/.ssh"
  chmod 700 "$HOME/.ssh"
  touch "$SSH_CONFIG"
  chmod 600 "$SSH_CONFIG"
  cp "$SSH_CONFIG" "$SSH_CONFIG.airlift.bak"
  temp="$(mktemp "$HOME/.ssh/config.XXXXXX")"

  awk -v start="$start" -v end="$end" '
    $0 == start { skipping = 1; next }
    $0 == end { skipping = 0; next }
    !skipping { print }
  ' "$SSH_CONFIG" >"$temp"

  cat >>"$temp" <<EOF

$start
Host $alias
  HostName $hostname
  User $username
  IdentityFile $KEY_FILE
  IdentitiesOnly yes
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 30
  ServerAliveCountMax 3
  TCPKeepAlive yes
  ForwardAgent no
$end
EOF

  chmod 600 "$temp"
  mv "$temp" "$SSH_CONFIG"
}

remote_install() {
  local install_mode="$1"
  local quoted_mode
  quoted_mode="$(shell_quote "$install_mode")"

  info "Checking the worker and installing the remote cockpit…"
  ssh "$AIRLIFT_ALIAS" "AIRLIFT_INSTALL=$quoted_mode bash -s" <<'REMOTE'
set -eu

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.codex/bin:$PATH"
mkdir -p "$HOME/.airlift/logs" "$HOME/.airlift/runtime" "$HOME/.local/bin"

add_login_path() {
  profile="$1"
  marker="# Added by Airlift"
  line='export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.codex/bin:$PATH"'
  touch "$profile"
  if ! grep -F "$marker" "$profile" >/dev/null 2>&1; then
    {
      printf '\n%s\n' "$marker"
      printf '%s\n' "$line"
    } >>"$profile"
  fi
}

add_login_path "$HOME/.zprofile"
add_login_path "$HOME/.bash_profile"

ensure_node() {
  node_major=0
  if command -v node >/dev/null 2>&1; then
    node_major="$(node -p 'Number(process.versions.node.split(".")[0])' 2>/dev/null || printf 0)"
  fi
  if [ "$node_major" -ge 22 ] && command -v npm >/dev/null 2>&1; then
    return
  fi

  command -v curl >/dev/null 2>&1 || {
    printf 'curl is required to install the user-local Node.js runtime.\n' >&2
    exit 1
  }
  command -v shasum >/dev/null 2>&1 || {
    printf 'shasum is required to verify the Node.js download.\n' >&2
    exit 1
  }

  printf 'Installing a verified user-local Node.js LTS runtime on the worker…\n'
  node_version="$(
    curl -fsSL https://nodejs.org/dist/index.tab |
      awk -F '\t' '
        NR > 1 {
          version = $1
          sub(/^v/, "", version)
          split(version, parts, ".")
          if (parts[1] >= 22 && $10 != "-" && $10 != "") {
            print $1
            exit
          }
        }
      '
  )"
  [ -n "$node_version" ] || {
    printf 'Could not resolve a supported Node.js LTS release.\n' >&2
    exit 1
  }

  case "$(uname -m)" in
    arm64) node_arch="arm64" ;;
    x86_64) node_arch="x64" ;;
    *)
      printf 'Unsupported Mac architecture: %s\n' "$(uname -m)" >&2
      exit 1
      ;;
  esac

  archive="node-${node_version}-darwin-${node_arch}.tar.gz"
  runtime_dir="$HOME/.airlift/runtime/node-${node_version}-darwin-${node_arch}"
  if [ ! -x "$runtime_dir/bin/node" ]; then
    temp_dir="$(mktemp -d "$HOME/.airlift/node-install.XXXXXX")"
    curl -fsSL "https://nodejs.org/dist/${node_version}/${archive}" -o "$temp_dir/$archive"
    expected="$(
      curl -fsSL "https://nodejs.org/dist/${node_version}/SHASUMS256.txt" |
        awk -v archive="$archive" '$2 == archive { print $1; exit }'
    )"
    [ -n "$expected" ] || {
      printf 'Could not find the Node.js checksum.\n' >&2
      exit 1
    }
    actual="$(shasum -a 256 "$temp_dir/$archive" | awk '{ print $1 }')"
    [ "$actual" = "$expected" ] || {
      printf 'Node.js checksum verification failed.\n' >&2
      exit 1
    }
    tar -xzf "$temp_dir/$archive" -C "$HOME/.airlift/runtime"
    rm -rf "$temp_dir"
  fi

  ln -sf "$runtime_dir/bin/node" "$HOME/.local/bin/node"
  ln -sf "$runtime_dir/bin/npm" "$HOME/.local/bin/npm"
  ln -sf "$runtime_dir/bin/npx" "$HOME/.local/bin/npx"
  hash -r
}

install_npm_tool() {
  command_name="$1"
  package_name="$2"
  display_name="$3"

  if command -v "$command_name" >/dev/null 2>&1; then
    return
  fi

  ensure_node
  printf 'Installing %s on the worker…\n' "$display_name"
  npm install -g --prefix "$HOME/.local" "$package_name"
  hash -r
}

install_codex() {
  install_npm_tool codex @openai/codex "Codex CLI"
}

install_claude() {
  install_npm_tool claude @anthropic-ai/claude-code "Claude Code"
}

install_cockpit() {
  install_npm_tool yepanywhere yepanywhere "Yep Anywhere"
}

case "$AIRLIFT_INSTALL" in
  cockpit|all)
    install_codex
    install_claude
    install_cockpit
    ;;
  codex)
    install_codex
    ;;
  claude)
    install_claude
    ;;
  none)
    ;;
  *)
    printf 'Unknown install mode: %s\n' "$AIRLIFT_INSTALL" >&2
    exit 1
    ;;
esac

printf 'Remote: %s · %s · %s\n' "$(scutil --get ComputerName 2>/dev/null || hostname)" "$(uname -m)" "$(sw_vers -productVersion 2>/dev/null || uname -r)"
if command -v codex >/dev/null 2>&1; then
  codex --version
fi
if command -v claude >/dev/null 2>&1; then
  claude --version
fi
if command -v yepanywhere >/dev/null 2>&1; then
  printf 'yepanywhere %s\n' "$(yepanywhere --version)"
fi
REMOTE
}

join_cmd() {
  local mode="$1"
  shift
  require ssh
  require ssh-keygen
  require ssh-copy-id

  [ "$#" -ge 1 ] || die "Usage: airlift $mode <user@mac-host> [--alias name] [--slots auto|N] [--transport auto|lan|tailscale] [--install cockpit|codex|claude|none] [--no-awake]"

  local target="$1"
  shift
  local alias=""
  local install_mode="cockpit"
  local keep_awake="1"
  local slots="auto"
  local transport="auto"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --alias)
        [ "$#" -ge 2 ] || die "--alias needs a value."
        alias="$2"
        shift 2
        ;;
      --slots)
        [ "$#" -ge 2 ] || die "--slots needs a value."
        slots="$2"
        shift 2
        ;;
      --transport)
        [ "$#" -ge 2 ] || die "--transport needs a value."
        transport="$2"
        shift 2
        ;;
      --tailscale)
        transport="tailscale"
        shift
        ;;
      --install)
        [ "$#" -ge 2 ] || die "--install needs a value."
        install_mode="$2"
        shift 2
        ;;
      --no-awake)
        keep_awake="0"
        shift
        ;;
      *)
        die "Unknown $mode option: $1"
        ;;
    esac
  done

  case "$install_mode" in cockpit|all|codex|claude|none) ;; *) die "Install mode must be cockpit, codex, claude, or none." ;; esac
  validate_slots "$slots"
  validate_transport "$transport"

  local username hostname
  if [[ "$target" == *"@"* ]]; then
    username="${target%@*}"
    hostname="${target#*@}"
  else
    username="$USER"
    hostname="$target"
    target="$username@$hostname"
  fi

  case "$username" in ""|*[!A-Za-z0-9._-]*) die "Invalid SSH username: $username" ;; esac
  case "$hostname" in ""|*[!A-Za-z0-9._:-]*) die "Invalid SSH hostname: $hostname" ;; esac

  if [ -z "$alias" ]; then
    if [ "$mode" = "setup" ]; then
      alias="spare-air"
    else
      alias="$(printf '%s' "$hostname" | sed 's/[^A-Za-z0-9._-]/-/g')"
    fi
  fi
  validate_alias "$alias"

  say ""
  say "${BOLD}Airlift ${mode}${RESET}"
  say "${DIM}This Mac → $target as $alias${RESET}"
  say ""

  if [ ! -f "$KEY_FILE" ]; then
    info "Creating a dedicated SSH key at $KEY_FILE"
    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    ssh-keygen -q -t ed25519 -f "$KEY_FILE" -N "" -C "airlift@${HOSTNAME:-$(hostname)}"
    chmod 600 "$KEY_FILE"
    chmod 644 "$KEY_FILE.pub"
  else
    ok "Dedicated SSH key already exists."
  fi

  add_ssh_config "$alias" "$hostname" "$username"
  ok "Added the private SSH connection '$alias'."

  if ! ssh -o BatchMode=yes -o ConnectTimeout=6 "$alias" true >/dev/null 2>&1; then
    warn "One Mac password prompt may appear to authorize this controller's SSH key."
    if ! ssh-copy-id -i "$KEY_FILE.pub" -o StrictHostKeyChecking=accept-new "$target"; then
      say ""
      warn "Could not reach the worker."
      say "On that Mac, enable: System Settings → General → Sharing → Remote Login"
      if [ "$transport" = "tailscale" ]; then
        say "Also confirm both Macs can see each other in Tailscale and the hostname is its MagicDNS name or 100.x address."
      fi
      say "Allow access for the '$username' user, then rerun the setup command."
      exit 1
    fi
  fi

  ssh -o BatchMode=yes -o ConnectTimeout=8 "$alias" true >/dev/null
  ok "Passwordless SSH is working."

  AIRLIFT_ALIAS="$alias"
  AIRLIFT_TARGET="$target"
  AIRLIFT_SLOTS="$slots"
  AIRLIFT_TRANSPORT="$transport"
  AIRLIFT_HARDWARE_UUID="$(remote_hardware_uuid "$alias" || true)"
  save_node

  if [ ! -f "$CONFIG_FILE" ]; then
    AIRLIFT_DEFAULT_NODE="$alias"
    AIRLIFT_LOCAL_PORT="3400"
    AIRLIFT_REMOTE_PORT="3400"
    AIRLIFT_PROJECT="~"
    save_config
  else
    load_config
    if [ "$mode" = "setup" ]; then
      AIRLIFT_DEFAULT_NODE="$alias"
      save_config
    fi
    load_node "$alias"
  fi

  remote_install "$install_mode"

  if [ "$install_mode" = "cockpit" ] || [ "$install_mode" = "all" ] || [ "$install_mode" = "codex" ]; then
    if ! ssh "$AIRLIFT_ALIAS" "$(remote_path_prefix) codex login status" >/dev/null 2>&1; then
      say ""
      info "Codex needs a one-time sign-in on $alias."
      ssh -t "$AIRLIFT_ALIAS" "$(remote_path_prefix) codex login --device-auth"
    else
      ok "Codex is authenticated on $alias."
    fi
  fi

  if [ "$install_mode" = "cockpit" ] || [ "$install_mode" = "all" ] || [ "$install_mode" = "claude" ]; then
    if ! ssh "$AIRLIFT_ALIAS" "$(remote_path_prefix) claude auth status" >/dev/null 2>&1; then
      say ""
      info "Claude Code needs a one-time sign-in on $alias."
      ssh -t "$AIRLIFT_ALIAS" "$(remote_path_prefix) claude auth login"
    else
      ok "Claude Code is authenticated on $alias."
    fi
  fi

  if [ "$keep_awake" = "1" ]; then
    awake_current_node
  fi

  say ""
  ok "Added $alias to the Airlift pool."
  if [ "$transport" = "tailscale" ]; then
    say "This worker can be reached away from the local Wi-Fi through its private Tailscale address."
  fi
  say ""
  say "Route work to the pool:"
  say "  ${BOLD}./airlift run --project '~/Developer/your-project' 'Your task'${RESET}"
  say "Or open the Codex + Claude cockpit:"
  say "  ${BOLD}./airlift open '~/Developer/your-project'${RESET}"
}

metrics_script() {
  cat <<'REMOTE'
set -u

cache_value() {
  key="$1"
  [ -r "$thermal_cache" ] || return 0
  awk -F '\t' -v key="$key" '$1 == key { print $2; exit }' "$thermal_cache" 2>/dev/null
}

clean_int() {
  value="$1"
  case "$value" in ""|*[!0-9]*) printf '0' ;; *) printf '%s' "$value" ;; esac
}

clean_float() {
  value="$1"
  case "$value" in ""|*[!0-9.]*) return 0 ;; *) printf '%s' "$value" ;; esac
}

jobs=0
if [ -d "$HOME/.airlift/jobs" ]; then
  for lease in "$HOME/.airlift/jobs"/job.*; do
    [ -f "$lease" ] || continue
    pid="$(head -n 1 "$lease" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      jobs=$((jobs + 1))
    else
      rm -f "$lease"
    fi
  done
fi

cores="$(sysctl -n hw.logicalcpu 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || printf 1)"
cores="$(clean_int "$cores")"
[ "$cores" -ge 1 ] || cores=1

if load_raw="$(sysctl -n vm.loadavg 2>/dev/null)"; then
  load="$(printf '%s' "$load_raw" | tr -d '{}' | awk '{ print $1 }')"
elif [ -r /proc/loadavg ]; then
  load="$(awk '{ print $1 }' /proc/loadavg)"
else
  load=0
fi
load="$(clean_float "$load")"
[ -n "$load" ] || load=0

agents="$(
  ps -axo command= 2>/dev/null |
    awk '
      /(^|[[:space:]\/])(codex([^[:space:]\/]*)?|claude)([[:space:]]|$)/ &&
      $0 !~ /airlift/ && $0 !~ /yepanywhere/ { count++ }
      END { print count + 0 }
    '
)"
agents="$(clean_int "$agents")"
busy="$jobs"
[ "$agents" -le "$busy" ] || busy="$agents"

if [ "${AIRLIFT_SLOTS:-auto}" = "auto" ]; then
  slots=$(((cores + 3) / 4))
  [ "$slots" -ge 1 ] || slots=1
else
  slots="$(clean_int "$AIRLIFT_SLOTS")"
  [ "$slots" -ge 1 ] || slots=1
fi

project="${AIRLIFT_PROJECT:-~}"
case "$project" in
  "~") project="$HOME" ;;
  "~/"*) project="$HOME/${project#\~/}" ;;
esac
ready=0
[ -d "$project" ] && ready=1

machine="$(scutil --get ComputerName 2>/dev/null || hostname)"
machine="$(printf '%s' "$machine" | tr '\t\n' '  ')"

mem_total="$(sysctl -n hw.memsize 2>/dev/null || printf 0)"
page_size="$(sysctl -n hw.pagesize 2>/dev/null || printf 4096)"
mem_used="$(
  vm_stat 2>/dev/null | awk -v page="$page_size" '
    /Pages active:/ { gsub(/\./,"",$NF); a=$NF+0 }
    /Pages wired/ { gsub(/\./,"",$NF); w=$NF+0 }
    /Pages occupied by compressor:/ { gsub(/\./,"",$NF); c=$NF+0 }
    END { print (a+w+c)*page + 0 }
  '
)"
mem_used="$(clean_int "$mem_used")"
mem_total="$(clean_int "$mem_total")"
if [ "$mem_total" -gt 0 ] && [ "$mem_used" -gt "$mem_total" ]; then
  mem_used="$mem_total"
fi

thermal_cache="${AIRLIFT_METRICS_CACHE:-$HOME/.airlift/metrics/latest.tsv}"
cpu_temp_c="${AIRLIFT_TEST_CPU_TEMP_C:-$(cache_value cpu_temp_c)}"
thermal_pressure="${AIRLIFT_TEST_THERMAL_PRESSURE:-$(cache_value thermal_pressure)}"
gpu_active_pct="${AIRLIFT_TEST_GPU_ACTIVE_PCT:-$(cache_value gpu_active_pct)}"
gpu_power_mw="${AIRLIFT_TEST_GPU_POWER_MW:-$(cache_value gpu_power_mw)}"
gpu_freq_mhz="${AIRLIFT_TEST_GPU_FREQ_MHZ:-$(cache_value gpu_freq_mhz)}"
cpu_power_mw="${AIRLIFT_TEST_CPU_POWER_MW:-$(cache_value cpu_power_mw)}"

cpu_temp_c="$(clean_float "$cpu_temp_c")"
gpu_active_pct="$(clean_float "$gpu_active_pct")"
gpu_power_mw="$(clean_float "$gpu_power_mw")"
gpu_freq_mhz="$(clean_float "$gpu_freq_mhz")"
cpu_power_mw="$(clean_float "$cpu_power_mw")"
thermal_pressure="$(printf '%s' "${thermal_pressure:-}" | tr '\t\n' '  ')"

gpu_name="$(
  /usr/sbin/system_profiler SPDisplaysDataType 2>/dev/null |
    awk -F ': ' '
      /Chipset Model:/ && model == "" { model=$2 }
      /Total Number of Cores:/ && cores == "" { cores=$2 }
      END {
        if (model != "" && cores != "") print model " " cores "c"
        else if (model != "") print model
      }
    '
)"
gpu_name="$(printf '%s' "${AIRLIFT_TEST_GPU_NAME:-$gpu_name}" | tr '\t\n' '  ')"

disk_used=0
disk_total=0
if disk_line="$(df -k "$project" 2>/dev/null | awk 'NR == 2 { printf "%d\t%d", ($2 - $4) * 1024, $2 * 1024 }')"; then
  IFS='	' read -r disk_used disk_total <<EOF
$disk_line
EOF
fi
disk_used="$(clean_int "$disk_used")"
disk_total="$(clean_int "$disk_total")"

power_source="$(pmset -g batt 2>/dev/null | awk -F "'" '/Now drawing from/ { print $2; exit }')"
battery_pct="$(pmset -g batt 2>/dev/null | awk -F '[\t%;]' '/InternalBattery|Battery/ { gsub(/[^0-9]/, "", $2); print $2; exit }')"
battery_pct="$(clean_int "$battery_pct")"
power_source="$(printf '%s' "${AIRLIFT_TEST_POWER_SOURCE:-${power_source:-}}" | tr '\t\n' '  ')"

[ -n "$cpu_temp_c" ] || cpu_temp_c="-"
[ -n "$thermal_pressure" ] || thermal_pressure="-"
[ -n "$gpu_active_pct" ] || gpu_active_pct="-"
[ -n "$gpu_power_mw" ] || gpu_power_mw="-"
[ -n "$gpu_freq_mhz" ] || gpu_freq_mhz="-"
[ -n "$cpu_power_mw" ] || cpu_power_mw="-"
[ -n "$gpu_name" ] || gpu_name="-"
[ -n "$power_source" ] || power_source="-"

tasks="$(
  ps -axo pid=,rss=,command= 2>/dev/null | awk '
    BEGIN { first=1 }
    {
      pid=$1; rss=$2
      cmd=$0
      sub(/^[[:space:]]*[0-9]+[[:space:]]+[0-9]+[[:space:]]+/, "", cmd)
      agent=""
      if (cmd ~ /(^|[\/[:space:]])claude([[:space:]]|$)/ && cmd !~ /airlift/) agent="claude"
      else if (cmd ~ /(^|[\/[:space:]])codex([[:space:]]|$)/ && cmd !~ /airlift/) agent="codex"
      if (agent == "") next
      gsub(/[;\t|]/, " ", cmd)
      gsub(/\r/, "", cmd)
      if (length(cmd) > 80) cmd=substr(cmd,1,80)
      if (!first) printf ";"
      first=0
      printf "%s|%s|%s|%s", agent, pid, rss, cmd
    }
  '
)"
printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
  "$busy" "$slots" "$load" "$cores" "$ready" "$jobs" "$machine" "$mem_used" "$mem_total" \
  "$cpu_temp_c" "$thermal_pressure" "$gpu_active_pct" "$gpu_power_mw" "$gpu_freq_mhz" "$cpu_power_mw" \
  "$gpu_name" "$disk_used" "$disk_total" "$battery_pct" "$power_source" "$tasks"
REMOTE
}

probe_node() {
  local alias="$1"
  local project="${2:-~}"
  load_node "$alias"

  local quoted_project quoted_slots metrics metrics_file
  quoted_project="$(shell_quote "$project")"
  quoted_slots="$(shell_quote "$AIRLIFT_SLOTS")"
  metrics_file="$(mktemp "$CONFIG_DIR/metrics.XXXXXX")"
  if ! metrics_script | ssh -o BatchMode=yes -o ConnectTimeout=5 "$AIRLIFT_ALIAS" \
    "AIRLIFT_METRICS=1 AIRLIFT_PROJECT=$quoted_project AIRLIFT_SLOTS=$quoted_slots bash -s" \
    >"$metrics_file"
  then
    rm -f "$metrics_file"
    return 1
  fi
  metrics="$(cat "$metrics_file")"
  rm -f "$metrics_file"

  local busy slots load cores ready jobs machine mem_used mem_total cpu_temp_c thermal_pressure
  local gpu_active_pct gpu_power_mw gpu_freq_mhz cpu_power_mw gpu_name disk_used disk_total battery_pct power_source tasks score
  IFS=$'\t' read -r busy slots load cores ready jobs machine mem_used mem_total cpu_temp_c thermal_pressure \
    gpu_active_pct gpu_power_mw gpu_freq_mhz cpu_power_mw gpu_name disk_used disk_total battery_pct power_source tasks <<<"$metrics"
  [ "${cpu_temp_c:-}" = "-" ] && cpu_temp_c=""
  [ "${thermal_pressure:-}" = "-" ] && thermal_pressure=""
  [ "${gpu_active_pct:-}" = "-" ] && gpu_active_pct=""
  [ "${gpu_power_mw:-}" = "-" ] && gpu_power_mw=""
  [ "${gpu_freq_mhz:-}" = "-" ] && gpu_freq_mhz=""
  [ "${cpu_power_mw:-}" = "-" ] && cpu_power_mw=""
  [ "${gpu_name:-}" = "-" ] && gpu_name=""
  [ "${power_source:-}" = "-" ] && power_source=""
  [ -n "${machine:-}" ] || machine="$AIRLIFT_ALIAS"
  mem_used="${mem_used:-0}"
  mem_total="${mem_total:-0}"
  score="$(
    awk -v busy="$busy" -v slots="$slots" -v load_value="$load" -v cores="$cores" \
      -v mem_used="$mem_used" -v mem_total="$mem_total" -v temp="$cpu_temp_c" \
      -v thermal="$thermal_pressure" -v gpu="$gpu_active_pct" \
      'BEGIN {
        if (slots < 1) slots = 1
        if (cores < 1) cores = 1
        score = (busy / slots) * 1000 + (load_value / cores) * 100
        if (mem_total > 0) {
          mem_ratio = mem_used / mem_total
          if (mem_ratio > 0.85) score += (mem_ratio - 0.85) * 2000
        }
        if (temp + 0 > 80) score += (temp - 80) * 20
        lower = tolower(thermal)
        if (lower != "" && lower !~ /nominal|normal|ok/) score += 500
        if (gpu + 0 > 80) score += (gpu - 80) * 5
        printf "%.1f", score
      }'
  )"
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$AIRLIFT_ALIAS" "$score" "$busy" "$slots" "$load" "$cores" "$ready" "$machine" "$AIRLIFT_TRANSPORT" "$AIRLIFT_TARGET" \
    "$mem_used" "$mem_total" "${cpu_temp_c:-}" "${thermal_pressure:-}" "${gpu_active_pct:-}" "${gpu_power_mw:-}" \
    "${gpu_freq_mhz:-}" "${cpu_power_mw:-}" "${gpu_name:-}" "${disk_used:-0}" "${disk_total:-0}" \
    "${battery_pct:-0}" "${power_source:-}" "${tasks:-}"
}

probe_pool() {
  local project="${1:-~}"
  mkdir -p "$CONFIG_DIR"
  AIRLIFT_PROBE_DIR="$(mktemp -d "$CONFIG_DIR/probe.XXXXXX")"
  local alias pids=""
  while IFS= read -r alias; do
    [ -n "$alias" ] || continue
    (
      if ! probe_node "$alias" "$project" >"$AIRLIFT_PROBE_DIR/$alias"; then
        : >"$AIRLIFT_PROBE_DIR/$alias.offline"
      fi
    ) &
    pids="$pids $!"
  done < <(list_node_aliases)
  local pid
  for pid in $pids; do
    wait "$pid" || true
  done
}

clear_probe_pool() {
  if [ -n "${AIRLIFT_PROBE_DIR:-}" ] && [ -d "$AIRLIFT_PROBE_DIR" ]; then
    rm -rf "$AIRLIFT_PROBE_DIR"
  fi
  AIRLIFT_PROBE_DIR=""
}

read_selected_record() {
  local record="$1"
  IFS=$'\t' read -r \
    AIRLIFT_SELECTED_ALIAS AIRLIFT_SELECTED_SCORE AIRLIFT_SELECTED_BUSY AIRLIFT_SELECTED_SLOTS \
    AIRLIFT_SELECTED_LOAD AIRLIFT_SELECTED_CORES AIRLIFT_SELECTED_READY AIRLIFT_SELECTED_MACHINE \
    AIRLIFT_SELECTED_TRANSPORT AIRLIFT_SELECTED_TARGET AIRLIFT_SELECTED_MEM_USED \
    AIRLIFT_SELECTED_MEM_TOTAL AIRLIFT_SELECTED_CPU_TEMP_C AIRLIFT_SELECTED_THERMAL_PRESSURE \
    AIRLIFT_SELECTED_GPU_ACTIVE_PCT AIRLIFT_SELECTED_GPU_POWER_MW AIRLIFT_SELECTED_GPU_FREQ_MHZ \
    AIRLIFT_SELECTED_CPU_POWER_MW AIRLIFT_SELECTED_GPU_NAME AIRLIFT_SELECTED_DISK_USED \
    AIRLIFT_SELECTED_DISK_TOTAL AIRLIFT_SELECTED_BATTERY_PCT AIRLIFT_SELECTED_POWER_SOURCE \
    AIRLIFT_SELECTED_TASKS <<<"$record"
  AIRLIFT_SELECTED_MEM_USED="${AIRLIFT_SELECTED_MEM_USED:-0}"
  AIRLIFT_SELECTED_MEM_TOTAL="${AIRLIFT_SELECTED_MEM_TOTAL:-0}"
  AIRLIFT_SELECTED_DISK_USED="${AIRLIFT_SELECTED_DISK_USED:-0}"
  AIRLIFT_SELECTED_DISK_TOTAL="${AIRLIFT_SELECTED_DISK_TOTAL:-0}"
  AIRLIFT_SELECTED_BATTERY_PCT="${AIRLIFT_SELECTED_BATTERY_PCT:-0}"
}

select_node() {
  local requested="${1:-auto}"
  local project="${2:-~}"
  local require_project="${3:-1}"
  [ "$requested" != "all" ] || die "This command needs one worker, not all."

  if [ "$requested" != "auto" ]; then
    local record
    if ! record="$(probe_node "$requested" "$project")"; then
      if [ "$require_project" = "0" ]; then
        AIRLIFT_SELECTED_ALIAS=""
        return 1
      fi
      die "Worker '$requested' is offline or unreachable over SSH."
    fi
    read_selected_record "$record"
    if [ "$require_project" != "0" ]; then
      [ "$AIRLIFT_SELECTED_READY" = "1" ] || die "Project '$project' does not exist on worker '$requested'."
    fi
    if node_is_self "$requested"; then
      if [ "$require_project" = "0" ]; then
        AIRLIFT_SELECTED_ALIAS=""
        return 1
      fi
      die "Worker '$requested' is this Mac. Hop needs a different machine."
    fi
    return
  fi

  probe_pool "$project"
  local self_uuid=""
  self_uuid="$(local_hardware_uuid || true)"
  local best
  best="$(
    for file in "$AIRLIFT_PROBE_DIR"/*; do
      [ -s "$file" ] || continue
      [ "${file##*.}" != "offline" ] || continue
      alias_name="$(basename "$file")"
      if [ -n "$self_uuid" ]; then
        (
          unset AIRLIFT_HARDWARE_UUID
          # shellcheck disable=SC1090
          source "$(node_file "$alias_name")" 2>/dev/null || exit 0
          if [ -n "${AIRLIFT_HARDWARE_UUID:-}" ] && [ "$AIRLIFT_HARDWARE_UUID" = "$self_uuid" ]; then
            exit 1
          fi
        ) || continue
      fi
      if [ "$require_project" = "0" ]; then
        cat "$file"
      else
        awk -F '\t' '$7 == 1' "$file"
      fi
    done |
      sort -t $'\t' -k2,2n -k1,1 |
      head -n 1
  )"
  if [ -z "$best" ]; then
    clear_probe_pool
    if [ "$require_project" = "0" ]; then
      AIRLIFT_SELECTED_ALIAS=""
      return 1
    fi
    die "No online worker has project '$project'. Run 'airlift nodes' or clone it with '--worker all'."
  fi
  read_selected_record "$best"
  clear_probe_pool
}

format_mem() {
  local used="${1:-0}" total="${2:-0}"
  awk -v u="$used" -v t="$total" 'BEGIN {
    if (t + 0 <= 0) { printf "-"; exit }
    printf "%.1f/%.0fG", u / 1073741824, t / 1073741824
  }'
}

format_temp() {
  local temp="${1:-}"
  if [ -z "$temp" ] || [ "$temp" = "-" ]; then
    printf '%s' '-'
  else
    awk -v t="$temp" 'BEGIN { printf "%.0fC", t }'
  fi
}

format_gpu() {
  local active="${1:-}" power="${2:-0}"
  awk -v a="$active" -v p="$power" 'BEGIN {
    out = "-"
    if (a != "" && a != "-") out = sprintf("%.0f%%", a)
    if (p + 0 > 0) {
      watts = (p + 0) / 1000
      if (out == "-") out = sprintf("%.1fW", watts)
      else out = out "/" sprintf("%.1fW", watts)
    }
    printf "%s", out
  }'
}

format_power() {
  local battery="${1:-}" source="${2:-}"
  if [ -n "$battery" ] && [ "$battery" != "0" ] && [ "$battery" != "-" ]; then
    printf '%s%%' "$battery"
  elif [ -n "$source" ] && [ "$source" != "-" ]; then
    printf '%s' "$source"
  else
    printf '%s' '-'
  fi
}

local_metrics_line() {
  metrics_script | AIRLIFT_PROJECT="${AIRLIFT_PROJECT:-~}" AIRLIFT_SLOTS="auto" bash -s
}

metrics_sampler_script() {
  cat <<'SAMPLER'
#!/bin/bash
set -u

out="${1:-}"
owner="${2:-}"
group="${3:-staff}"
[ -n "$out" ] || exit 0

mkdir -p "$(dirname "$out")"
sample=""
if [ -x /usr/bin/powermetrics ]; then
  sample="$(/usr/bin/powermetrics --samplers thermal,gpu_power,cpu_power,ane_power -n 1 -i 500 --hide-cpu-duty-cycle 2>/dev/null || true)"
fi

first_number_matching() {
  pattern="$1"
  printf '%s\n' "$sample" | awk -v pattern="$pattern" '
    {
      line=tolower($0)
      if (line ~ pattern) {
        for (i = 1; i <= NF; i++) {
          value=$i
          gsub(/[^0-9.]/, "", value)
          if (value ~ /^[0-9]+(\.[0-9]+)?$/) {
            print value
            exit
          }
        }
      }
    }
  '
}

first_text_matching() {
  pattern="$1"
  printf '%s\n' "$sample" | awk -v pattern="$pattern" '
    {
      line=tolower($0)
      if (line ~ pattern) {
        sub(/^[^:]*:[[:space:]]*/, "")
        print
        exit
      }
    }
  '
}

emit() {
  key="$1"
  value="$(printf '%s' "${2:-}" | tr '\t\r\n' '   ')"
  printf '%s\t%s\n' "$key" "$value"
}

cpu_temp_c="$(first_number_matching 'cpu.*temperature|temperature.*cpu|die.*temperature|package.*temperature')"
thermal_pressure="$(first_text_matching 'thermal pressure|thermal level')"
gpu_active_pct="$(first_number_matching 'gpu.*active.*residency|gpu.*residency|gpu.*active')"
gpu_power_mw="$(first_number_matching 'gpu.*power')"
gpu_freq_mhz="$(first_number_matching 'gpu.*frequency')"
cpu_power_mw="$(first_number_matching 'cpu.*power')"
ane_power_mw="$(first_number_matching 'ane.*power')"

tmp="$(mktemp "${out}.XXXXXX")" || exit 1
{
  emit updated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  emit cpu_temp_c "$cpu_temp_c"
  emit thermal_pressure "$thermal_pressure"
  emit gpu_active_pct "$gpu_active_pct"
  emit gpu_power_mw "$gpu_power_mw"
  emit gpu_freq_mhz "$gpu_freq_mhz"
  emit cpu_power_mw "$cpu_power_mw"
  emit ane_power_mw "$ane_power_mw"
} >"$tmp"

if [ -n "$owner" ]; then
  chown "$owner:$group" "$tmp" 2>/dev/null || chown "$owner" "$tmp" 2>/dev/null || true
fi
chmod 0644 "$tmp"
mv "$tmp" "$out"
SAMPLER
}

metrics_cmd() {
  local action="${1:-status}"
  local cache="$HOME/.airlift/metrics/latest.tsv"
  case "$action" in
    status)
      if [ -r "$cache" ]; then
        say "Airlift metrics cache: $cache"
        awk -F '\t' '{ printf "  %-18s %s\n", $1, $2 }' "$cache"
      else
        say "Airlift metrics sampler is not installed for this user."
        say "Run: airlift metrics install"
      fi
      ;;
    install)
      [ "$(uname -s)" = "Darwin" ] || die "Airlift metrics install requires macOS."
      [ -x /usr/bin/powermetrics ] || die "powermetrics is missing on this Mac."
      /usr/bin/sudo -v || die "Administrator approval is required to install the metrics sampler."

      local label support_dir script_path plist temp_script temp_plist user group
      user="$(id -un)"
      group="$(id -gn)"
      label="com.airlift.metrics.$(id -u)"
      support_dir="/Library/Application Support/Airlift"
      script_path="$support_dir/airlift-metrics-sampler.sh"
      plist="/Library/LaunchDaemons/$label.plist"

      mkdir -p "$HOME/.airlift/metrics"
      chmod 755 "$HOME/.airlift" "$HOME/.airlift/metrics"

      temp_script="$(mktemp "${TMPDIR:-/tmp}/airlift-metrics.XXXXXX")"
      metrics_sampler_script >"$temp_script"
      chmod 755 "$temp_script"
      /usr/bin/sudo /usr/bin/install -d -o root -g wheel -m 755 "$support_dir"
      /usr/bin/sudo /usr/bin/install -o root -g wheel -m 755 "$temp_script" "$script_path"
      rm -f "$temp_script"

      temp_plist="$(mktemp "${TMPDIR:-/tmp}/airlift-metrics.XXXXXX.plist")"
      cat >"$temp_plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>$script_path</string>
    <string>$cache</string>
    <string>$user</string>
    <string>$group</string>
  </array>
  <key>StartInterval</key>
  <integer>5</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/airlift-metrics.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/airlift-metrics.err</string>
</dict>
</plist>
EOF
      /usr/bin/sudo /usr/bin/install -o root -g wheel -m 644 "$temp_plist" "$plist"
      rm -f "$temp_plist"
      /usr/bin/sudo /bin/launchctl bootout system "$plist" >/dev/null 2>&1 || true
      if ! /usr/bin/sudo /bin/launchctl bootstrap system "$plist" 2>/dev/null; then
        /usr/bin/sudo /bin/launchctl load -w "$plist"
      fi
      /usr/bin/sudo /bin/launchctl kickstart -k "system/$label" >/dev/null 2>&1 || true
      /usr/bin/sudo "$script_path" "$cache" "$user" "$group" >/dev/null 2>&1 || true
      ok "Installed the Airlift temperature/GPU sampler."
      say "Metrics cache: $cache"
      ;;
    *)
      die "Usage: airlift metrics status|install"
      ;;
  esac
}

pool_json() {
  require python3
  load_config optional || true
  local dump
  dump="$(mktemp "${TMPDIR:-/tmp}/airlift-pool.XXXXXX")"
  local local_line busy slots load cores ready jobs machine mem_used mem_total cpu_temp_c thermal_pressure
  local gpu_active_pct gpu_power_mw gpu_freq_mhz cpu_power_mw gpu_name disk_used disk_total battery_pct power_source tasks
  local_line="$(local_metrics_line)"
  IFS=$'\t' read -r busy slots load cores ready jobs machine mem_used mem_total cpu_temp_c thermal_pressure \
    gpu_active_pct gpu_power_mw gpu_freq_mhz cpu_power_mw gpu_name disk_used disk_total battery_pct power_source tasks <<<"$local_line"
  printf 'controller\tthis-mac\tlocal\t0\t%s\t%s\t%s\t%s\t%s\t%s\tlocal\tthis Mac\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "${busy:-0}" "${slots:-1}" "${load:-0}" "${cores:-1}" "${ready:-1}" "${machine:-this Mac}" \
    "${mem_used:-0}" "${mem_total:-0}" "${cpu_temp_c:-}" "${thermal_pressure:-}" "${gpu_active_pct:-}" \
    "${gpu_power_mw:-}" "${gpu_freq_mhz:-}" "${cpu_power_mw:-}" "${gpu_name:-}" "${disk_used:-0}" \
    "${disk_total:-0}" "${battery_pct:-0}" "${power_source:-}" "${tasks:-}" >"$dump"

  if [ -d "$NODES_DIR" ]; then
    probe_pool "~"
    local alias record
    while IFS= read -r alias; do
      [ -n "$alias" ] || continue
      if [ -s "$AIRLIFT_PROBE_DIR/$alias" ]; then
        record="$(cat "$AIRLIFT_PROBE_DIR/$alias")"
        read_selected_record "$record"
        printf 'worker\t%s\tonline\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
          "$AIRLIFT_SELECTED_ALIAS" "$AIRLIFT_SELECTED_SCORE" \
          "$AIRLIFT_SELECTED_BUSY" "$AIRLIFT_SELECTED_SLOTS" "$AIRLIFT_SELECTED_LOAD" \
          "$AIRLIFT_SELECTED_CORES" "$AIRLIFT_SELECTED_READY" "$AIRLIFT_SELECTED_MACHINE" \
          "$AIRLIFT_SELECTED_TRANSPORT" "$AIRLIFT_SELECTED_TARGET" \
          "$AIRLIFT_SELECTED_MEM_USED" "$AIRLIFT_SELECTED_MEM_TOTAL" \
          "${AIRLIFT_SELECTED_CPU_TEMP_C:-}" "${AIRLIFT_SELECTED_THERMAL_PRESSURE:-}" \
          "${AIRLIFT_SELECTED_GPU_ACTIVE_PCT:-}" "${AIRLIFT_SELECTED_GPU_POWER_MW:-}" \
          "${AIRLIFT_SELECTED_GPU_FREQ_MHZ:-}" "${AIRLIFT_SELECTED_CPU_POWER_MW:-}" \
          "${AIRLIFT_SELECTED_GPU_NAME:-}" "${AIRLIFT_SELECTED_DISK_USED:-0}" \
          "${AIRLIFT_SELECTED_DISK_TOTAL:-0}" "${AIRLIFT_SELECTED_BATTERY_PCT:-0}" \
          "${AIRLIFT_SELECTED_POWER_SOURCE:-}" \
          "${AIRLIFT_SELECTED_TASKS:-}" >>"$dump"
      else
        load_node "$alias"
        printf 'worker\t%s\toffline\t0\t0\t0\t0\t0\t0\t%s\t%s\t%s\t0\t0\t\t\t\t\t\t\t0\t0\t0\t\t\n' \
          "$AIRLIFT_ALIAS" "$AIRLIFT_TARGET" "$AIRLIFT_TRANSPORT" "$AIRLIFT_TARGET" >>"$dump"
      fi
    done < <(list_node_aliases)
    clear_probe_pool
  fi

  python3 - "$dump" "$EVENTS_FILE" "$VERSION" <<'PY'
import json, os, sys
from datetime import datetime, timezone

dump, events_path, version = sys.argv[1], sys.argv[2], sys.argv[3]
machines = []
with open(dump, encoding="utf-8") as handle:
    for raw in handle:
        line = raw.rstrip("\n")
        if not line:
            continue
        parts = line.split("\t")
        parts.extend([""] * 26)
        (
            role, alias, status, score, busy, slots, load, cores, ready, name,
            transport, target, mem_used, mem_total, cpu_temp_c, thermal_pressure,
            gpu_active_pct, gpu_power_mw, gpu_freq_mhz, cpu_power_mw, gpu_name,
            disk_used, disk_total, battery_pct, power_source, tasks
        ) = parts[:26]

        def nint(value, default=0):
            try:
                return int(float(value))
            except (TypeError, ValueError):
                return default

        def nfloat(value):
            if value == "-":
                return None
            try:
                return float(value)
            except (TypeError, ValueError):
                return None

        def text(value):
            return "" if value == "-" else value

        task_list = []
        if tasks:
            for part in tasks.split(";"):
                bits = part.split("|", 3)
                if len(bits) < 3:
                    continue
                task_list.append({
                    "agent": bits[0],
                    "pid": nint(bits[1]),
                    "rss_kb": nint(bits[2]),
                    "command": bits[3] if len(bits) > 3 else "",
                })
        machines.append({
            "id": alias,
            "role": role,
            "alias": alias,
            "status": status,
            "score": score,
            "busy": nint(busy),
            "slots": max(1, nint(slots, 1)),
            "load": load or "0",
            "cores": nint(cores, 1),
            "ready": ready,
            "name": name or alias,
            "transport": transport,
            "target": target,
            "mem_used": nint(mem_used),
            "mem_total": nint(mem_total),
            "cpu_temp_c": nfloat(cpu_temp_c),
            "thermal_pressure": text(thermal_pressure),
            "gpu_active_pct": nfloat(gpu_active_pct),
            "gpu_power_mw": nfloat(gpu_power_mw),
            "gpu_freq_mhz": nfloat(gpu_freq_mhz),
            "cpu_power_mw": nfloat(cpu_power_mw),
            "gpu_name": text(gpu_name),
            "disk_used": nint(disk_used),
            "disk_total": nint(disk_total),
            "battery_pct": nint(battery_pct) if battery_pct not in ("", "-") else None,
            "power_source": text(power_source),
            "tasks": task_list,
        })
os.remove(dump)
events = []
if os.path.isfile(events_path):
    with open(events_path, encoding="utf-8") as handle:
        for raw in handle:
            at, sep, message = raw.rstrip("\n").partition("\t")
            if not sep:
                continue
            events.append({"at": at, "message": message})
    events = list(reversed(events))[:40]
print(json.dumps({
    "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "version": version,
    "machines": machines,
    "events": events,
}, ensure_ascii=False))
PY
}

nodes_cmd() {
  if [ "${1:-}" = "--json" ]; then
    pool_json
    return
  fi
  load_config optional || true
  local local_line busy slots load cores ready jobs machine mem_used mem_total cpu_temp_c thermal_pressure
  local gpu_active_pct gpu_power_mw gpu_freq_mhz cpu_power_mw gpu_name disk_used disk_total battery_pct power_source tasks
  local_line="$(local_metrics_line)"
  IFS=$'\t' read -r busy slots load cores ready jobs machine mem_used mem_total cpu_temp_c thermal_pressure \
    gpu_active_pct gpu_power_mw gpu_freq_mhz cpu_power_mw gpu_name disk_used disk_total battery_pct power_source tasks <<<"$local_line"
  probe_pool "~"
  say ""
  say "${BOLD}Airlift pool${RESET}"
  printf '%-18s %-9s %-8s %-7s %-10s %-6s %-10s %-10s %-6s %-10s %s\n' \
    "WORKER" "STATUS" "USE" "LOAD" "RAM" "CPU" "GPU" "DISK" "PWR" "NET" "MACHINE"
  printf '%-18s %-9s %-8s %-7s %-10s %-6s %-10s %-10s %-6s %-10s %s\n' \
    "this-mac" "local" "${busy:-0}/${slots:-1}" \
    "${load:-0}" "$(format_mem "${mem_used:-0}" "${mem_total:-0}")" \
    "$(format_temp "${cpu_temp_c:-}")" \
    "$(format_gpu "${gpu_active_pct:-}" "${gpu_power_mw:-0}")" \
    "$(format_mem "${disk_used:-0}" "${disk_total:-0}")" \
    "$(format_power "${battery_pct:-}" "${power_source:-}")" \
    "local" \
    "${machine:-this Mac}"
  local alias record
  while IFS= read -r alias; do
    [ -n "$alias" ] || continue
    if [ -s "$AIRLIFT_PROBE_DIR/$alias" ]; then
      record="$(cat "$AIRLIFT_PROBE_DIR/$alias")"
      read_selected_record "$record"
      printf '%-18s %-9s %-8s %-7s %-10s %-6s %-10s %-10s %-6s %-10s %s\n' \
        "$alias" "online" "$AIRLIFT_SELECTED_BUSY/$AIRLIFT_SELECTED_SLOTS" \
        "$AIRLIFT_SELECTED_LOAD" "$(format_mem "$AIRLIFT_SELECTED_MEM_USED" "$AIRLIFT_SELECTED_MEM_TOTAL")" \
        "$(format_temp "${AIRLIFT_SELECTED_CPU_TEMP_C:-}")" \
        "$(format_gpu "${AIRLIFT_SELECTED_GPU_ACTIVE_PCT:-}" "${AIRLIFT_SELECTED_GPU_POWER_MW:-0}")" \
        "$(format_mem "${AIRLIFT_SELECTED_DISK_USED:-0}" "${AIRLIFT_SELECTED_DISK_TOTAL:-0}")" \
        "$(format_power "${AIRLIFT_SELECTED_BATTERY_PCT:-}" "${AIRLIFT_SELECTED_POWER_SOURCE:-}")" \
        "$AIRLIFT_SELECTED_TRANSPORT" \
        "$AIRLIFT_SELECTED_MACHINE"
    else
      load_node "$alias"
      printf '%-18s %-9s %-8s %-7s %-10s %-6s %-10s %-10s %-6s %-10s %s\n' "$alias" "offline" "-" "-" "-" "-" "-" "-" "-" "$AIRLIFT_TRANSPORT" "$AIRLIFT_TARGET"
    fi
  done < <(list_node_aliases)
  clear_probe_pool
  say ""
  say "USE is active agent work / configured slots. Auto routing also considers load, RAM pressure, CPU temperature, thermal pressure, and GPU activity."
  say "Live board: airlift dashboard"
}

load_command_node() {
  local requested="${1:-}"
  load_config
  [ -n "$requested" ] || requested="$AIRLIFT_DEFAULT_NODE"
  if [ "$requested" = "auto" ]; then
    select_node auto "~"
    requested="$AIRLIFT_SELECTED_ALIAS"
  fi
  load_node "$requested"
}

stop_active_tunnel() {
  local alias="" local_port=""
  if [ -f "$ACTIVE_TUNNEL_FILE" ]; then
    unset AIRLIFT_TUNNEL_ALIAS AIRLIFT_TUNNEL_LOCAL_PORT
    # shellcheck disable=SC1090
    source "$ACTIVE_TUNNEL_FILE"
    alias="${AIRLIFT_TUNNEL_ALIAS:-}"
    local_port="${AIRLIFT_TUNNEL_LOCAL_PORT:-}"
  fi
  if [ -n "$alias" ]; then
    validate_alias "$alias"
    local socket
    socket="$(ssh_socket "$alias")"
    if [ -S "$socket" ]; then
      ssh -S "$socket" -O exit "$alias" >/dev/null 2>&1 || true
      rm -f "$socket"
    fi
  elif [ -d "$NODES_DIR" ]; then
    # v0.2 did not record the active alias. Close any known legacy control socket.
    while IFS= read -r alias; do
      [ -n "$alias" ] || continue
      local socket
      socket="$(ssh_socket "$alias")"
      if [ -S "$socket" ]; then
        ssh -S "$socket" -O exit "$alias" >/dev/null 2>&1 || true
        rm -f "$socket"
      fi
    done < <(list_node_aliases)
  fi
  rm -f "$ACTIVE_TUNNEL_FILE"
}

save_active_tunnel() {
  mkdir -p "$CONFIG_DIR"
  umask 077
  {
    printf 'AIRLIFT_TUNNEL_ALIAS=%s\n' "$(shell_quote "$1")"
    printf 'AIRLIFT_TUNNEL_LOCAL_PORT=%s\n' "$(shell_quote "$2")"
  } >"$ACTIVE_TUNNEL_FILE"
  chmod 600 "$ACTIVE_TUNNEL_FILE"
}

stop_cmd() {
  [ -f "$CONFIG_FILE" ] && load_config
  stop_active_tunnel
  ok "Closed the private SSH tunnel. Running agents remain on their worker."
}

shutdown_cmd() {
  local worker=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --worker) [ "$#" -ge 2 ] || die "--worker needs a value."; worker="$2"; shift 2 ;;
      *) die "Unknown shutdown option: $1" ;;
    esac
  done
  load_command_node "$worker"
  stop_active_tunnel
  local quoted_port
  quoted_port="$(shell_quote "$AIRLIFT_REMOTE_PORT")"
  ssh "$AIRLIFT_ALIAS" "AIRLIFT_PORT=$quoted_port bash -s" <<'REMOTE' >/dev/null 2>&1 || true
set -eu
pid_file="$HOME/.airlift/yep-$AIRLIFT_PORT.pid"
if [ -f "$pid_file" ]; then
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    command_line="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    case "$command_line" in
      *yepanywhere*) kill "$pid" 2>/dev/null || true ;;
    esac
  fi
  rm -f "$pid_file"
fi
REMOTE
  ok "Stopped the cockpit on $AIRLIFT_ALIAS."
}

cockpit_cmd() {
  load_config
  require ssh
  require open

  local project="$AIRLIFT_PROJECT"
  local local_port="$AIRLIFT_LOCAL_PORT"
  local remote_port="$AIRLIFT_REMOTE_PORT"
  local worker="auto"

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --local-port) [ "$#" -ge 2 ] || die "--local-port needs a value."; local_port="$2"; shift 2 ;;
      --remote-port) [ "$#" -ge 2 ] || die "--remote-port needs a value."; remote_port="$2"; shift 2 ;;
      --worker) [ "$#" -ge 2 ] || die "--worker needs a value."; worker="$2"; shift 2 ;;
      -*) die "Unknown cockpit option: $1" ;;
      *) project="$1"; shift ;;
    esac
  done

  validate_port "$local_port"
  validate_port "$remote_port"
  select_node "$worker" "$project"
  load_node "$AIRLIFT_SELECTED_ALIAS"

  AIRLIFT_LOCAL_PORT="$local_port"
  AIRLIFT_REMOTE_PORT="$remote_port"
  AIRLIFT_PROJECT="$project"
  save_config

  if ! ssh "$AIRLIFT_ALIAS" "$(remote_path_prefix) command -v yepanywhere >/dev/null" >/dev/null 2>&1; then
    die "Yep Anywhere is not installed on $AIRLIFT_ALIAS. Rerun: airlift join $AIRLIFT_TARGET --alias $AIRLIFT_ALIAS"
  fi

  stop_active_tunnel
  if command -v lsof >/dev/null 2>&1 && lsof -nP -iTCP:"$local_port" -sTCP:LISTEN >/dev/null 2>&1; then
    die "Local port $local_port is already in use. Try: airlift open --local-port 3401"
  fi

  local quoted_project quoted_port resolved_project remote_home
  quoted_project="$(shell_quote "$project")"
  quoted_port="$(shell_quote "$remote_port")"
  case "$project" in
    "~") remote_home="$(ssh "$AIRLIFT_ALIAS" 'printf %s "$HOME"')"; resolved_project="$remote_home" ;;
    "~/"*) remote_home="$(ssh "$AIRLIFT_ALIAS" 'printf %s "$HOME"')"; resolved_project="$remote_home/${project#\~/}" ;;
    *) resolved_project="$project" ;;
  esac

  info "Starting the Codex + Claude cockpit on ${AIRLIFT_ALIAS}…"
  ssh "$AIRLIFT_ALIAS" "AIRLIFT_PROJECT=$quoted_project AIRLIFT_PORT=$quoted_port bash -s" <<'REMOTE'
set -eu
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.codex/bin:$PATH"
project="$AIRLIFT_PROJECT"
case "$project" in
  "~") project="$HOME" ;;
  "~/"*) project="$HOME/${project#\~/}" ;;
esac

mkdir -p "$HOME/.airlift/logs"
pid_file="$HOME/.airlift/yep-$AIRLIFT_PORT.pid"
log_file="$HOME/.airlift/logs/yep-$AIRLIFT_PORT.log"
running=0
if [ -f "$pid_file" ]; then
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    command_line="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    case "$command_line" in *yepanywhere*) running=1 ;; esac
  fi
fi

if [ "$running" -ne 1 ]; then
  if curl -fsS "http://127.0.0.1:$AIRLIFT_PORT/api/version" 2>/dev/null | grep -F '"current"' >/dev/null 2>&1; then
    running=1
  else
    YEP_BIN="$(command -v yepanywhere)"
    nohup "$YEP_BIN" --host 127.0.0.1 --port "$AIRLIFT_PORT" >"$log_file" 2>&1 </dev/null &
    pid="$!"
    printf '%s\n' "$pid" >"$pid_file"
  fi
fi

ready=0
attempt=0
while [ "$attempt" -lt 80 ]; do
  if curl -fsS "http://127.0.0.1:$AIRLIFT_PORT/api/version" 2>/dev/null | grep -F '"current"' >/dev/null 2>&1; then
    ready=1
    break
  fi
  if [ "$running" -ne 1 ] && ! kill -0 "$pid" 2>/dev/null; then break; fi
  attempt=$((attempt + 1))
  sleep 0.25
done

if [ "$ready" -ne 1 ]; then
  tail -n 30 "$log_file" >&2 || true
  exit 1
fi

if [ "$project" != "$HOME" ]; then
  [ -d "$project" ] || { printf 'Remote project does not exist: %s\n' "$project" >&2; exit 1; }
  payload="$(node -e 'process.stdout.write(JSON.stringify({path: process.argv[1]}))' "$project")"
  curl -fsS -X POST -H 'Content-Type: application/json' -H 'X-Yep-Anywhere: true' \
    --data "$payload" "http://127.0.0.1:$AIRLIFT_PORT/api/projects" >/dev/null 2>&1 || true
fi
REMOTE

  local socket
  socket="$(ssh_socket "$AIRLIFT_ALIAS")"
  rm -f "$socket"
  ssh -fN -M -S "$socket" -o ExitOnForwardFailure=yes -o ControlPersist=no \
    -L "$local_port:127.0.0.1:$remote_port" "$AIRLIFT_ALIAS"
  save_active_tunnel "$AIRLIFT_ALIAS" "$local_port"

  ok "Routed to $AIRLIFT_ALIAS ($AIRLIFT_SELECTED_MACHINE, $AIRLIFT_SELECTED_BUSY/$AIRLIFT_SELECTED_SLOTS slots active)."
  local url="http://127.0.0.1:$local_port"
  if [ "$project" != "~" ]; then
    local project_id
    project_id="$(printf '%s' "$resolved_project" | openssl base64 -A | tr '+/' '-_' | tr -d '=')"
    url="$url/new-session?projectId=$project_id"
  fi
  open "$url"
  say ""
  say "This cockpit is pinned to $AIRLIFT_ALIAS so follow-ups keep the same files and session history."
  say "Closing the browser does not stop active work."
}

local_hardware_uuid() {
  if [ -n "${AIRLIFT_TEST_SELF_UUID:-}" ]; then
    printf '%s' "$AIRLIFT_TEST_SELF_UUID"
    return 0
  fi
  ioreg -d2 -c IOPlatformExpertDevice 2>/dev/null | awk -F'"' '/IOPlatformUUID/{ print $4; exit }'
}

remote_hardware_uuid() {
  local alias="$1"
  ssh -o BatchMode=yes -o ConnectTimeout=8 "$alias" \
    'ioreg -d2 -c IOPlatformExpertDevice 2>/dev/null | awk -F"\"" "/IOPlatformUUID/{ print \$4; exit }"' |
    tr -d '\n\r'
}

node_is_self() {
  local alias="$1"
  local self_uuid node_uuid
  self_uuid="$(local_hardware_uuid || true)"
  [ -n "$self_uuid" ] || return 1
  load_node "$alias"
  node_uuid="${AIRLIFT_HARDWARE_UUID:-}"
  [ -n "$node_uuid" ] && [ "$node_uuid" = "$self_uuid" ]
}

force_local_requested() {
  [ "${AIRLIFT_LOCAL:-0}" = "1" ] && return 0
  [ -f "$FORCE_LOCAL_FILE" ] && return 0
  return 1
}

notify_airlift() {
  local message="$1"
  info "$message" >&2
  mkdir -p "$CONFIG_DIR"
  printf '%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$message" >>"$EVENTS_FILE" 2>/dev/null || true
  if [ -f "$EVENTS_FILE" ]; then
    tail -n 80 "$EVENTS_FILE" >"$EVENTS_FILE.tmp" 2>/dev/null && mv "$EVENTS_FILE.tmp" "$EVENTS_FILE"
  fi
  if [ -n "${AIRLIFT_TEST_METRICS_DIR:-}" ] || [ -n "${AIRLIFT_TEST_SSH_LOG:-}" ]; then
    return 0
  fi
  if command -v osascript >/dev/null 2>&1; then
    osascript -e "display notification $(shell_quote "$message") with title \"Airlift\"" >/dev/null 2>&1 || true
  fi
}

real_bin_path() {
  local agent="$1"
  local recorded=""
  if [ -f "$REAL_BINARIES_FILE" ]; then
    # shellcheck disable=SC1090
    source "$REAL_BINARIES_FILE"
    case "$agent" in
      claude) recorded="${AIRLIFT_REAL_CLAUDE:-}" ;;
      codex) recorded="${AIRLIFT_REAL_CODEX:-}" ;;
    esac
  fi
  if [ -n "$recorded" ] && [ -x "$recorded" ]; then
    printf '%s' "$recorded"
    return 0
  fi
  local path
  path="$(command -v "$agent" || true)"
  if [ -n "$path" ] && [ -x "$path" ]; then
    printf '%s' "$path"
    return 0
  fi
  return 1
}

record_real_binaries() {
  mkdir -p "$CONFIG_DIR"
  umask 077
  local claude_path="" codex_path=""
  claude_path="$(command -v claude 2>/dev/null || true)"
  codex_path="$(command -v codex 2>/dev/null || true)"
  {
    printf 'AIRLIFT_REAL_CLAUDE=%s\n' "$(shell_quote "$claude_path")"
    printf 'AIRLIFT_REAL_CODEX=%s\n' "$(shell_quote "$codex_path")"
  } >"$REAL_BINARIES_FILE"
  chmod 600 "$REAL_BINARIES_FILE"
}

sync_root_for() {
  local cwd="$1"
  if [ -d "$cwd/.git" ] || git -C "$cwd" rev-parse --show-toplevel >/dev/null 2>&1; then
    git -C "$cwd" rev-parse --show-toplevel
    return 0
  fi
  printf '%s' "$cwd"
}

lease_id() {
  date +%Y%m%d%H%M%S
  printf '%s' "$$"
}

lock_path_for() {
  local root="$1"
  mkdir -p "$LOCKS_DIR"
  local hash
  hash="$(printf '%s' "$root" | shasum | awk '{ print $1 }')"
  printf '%s/%s' "$LOCKS_DIR" "$hash"
}

try_overlay_lock() {
  local root="$1" lease="$2"
  local file pid
  file="$(lock_path_for "$root")"
  if [ -f "$file" ]; then
    pid="$(awk '{ print $1 }' "$file")"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      return 1
    fi
  fi
  printf '%s %s\n' "$$" "$lease" >"$file"
  return 0
}

release_overlay_lock() {
  local file="$1"
  [ -n "$file" ] || return 0
  [ -f "$file" ] || return 0
  local owner
  owner="$(awk '{ print $1 }' "$file")"
  if [ "$owner" = "$$" ]; then
    rm -f "$file"
  fi
}

rsync_common_excludes() {
  printf '%s\n' '--exclude=node_modules' '--exclude=dist' '--exclude=build' '--exclude=.next' '--exclude=target'
}

rsync_pull_excludes() {
  rsync_common_excludes
  printf '%s\n' '--exclude=.git'
}

safe_remote_name() {
  local name="$1"
  name="$(printf '%s' "$name" | sed 's/[^A-Za-z0-9._-]/-/g')"
  [ -n "$name" ] || name="project"
  printf '%s' "$name"
}

ensure_worktree() {
  local local_root="$1"
  local local_cwd="$2"
  local lease="$3"
  AIRLIFT_REMOTE_PROJECT="$local_root"
  AIRLIFT_REMOTE_CWD="$local_cwd"
  if [ -n "${AIRLIFT_TEST_METRICS_DIR:-}" ]; then
    return 0
  fi
  local repo_name rel=""
  repo_name="$(safe_remote_name "$(basename "$local_root")")"
  if [ "$local_cwd" != "$local_root" ]; then
    rel="${local_cwd#"$local_root"/}"
  fi
  local remote_root remote_cwd
  remote_root="\$HOME/airlift/worktrees/${repo_name}/${lease}"
  if [ -n "$rel" ] && [ "$rel" != "$local_cwd" ]; then
    remote_cwd="${remote_root}/${rel}"
  else
    remote_cwd="$remote_root"
  fi
  local remote_rel expanded remote_home
  remote_rel="airlift/worktrees/${repo_name}/${lease}"
  remote_home="$(ssh -o BatchMode=yes "$AIRLIFT_ALIAS" 'printf %s "$HOME"' </dev/null)"
  expanded="$remote_home/$remote_rel"
  ssh -o BatchMode=yes -o ConnectTimeout=8 "$AIRLIFT_ALIAS" \
    "mkdir -p $(shell_quote "$expanded")" </dev/null >/dev/null
  # shellcheck disable=SC2046
  rsync -a --delete $(rsync_common_excludes) \
    --exclude=.env --exclude=.env.local \
    "$local_root/" "$AIRLIFT_ALIAS:$expanded/"
  if [ -f "$local_root/.env" ]; then
    rsync -a "$local_root/.env" "$AIRLIFT_ALIAS:$expanded/.env"
  fi
  if [ -f "$local_root/.env.local" ]; then
    rsync -a "$local_root/.env.local" "$AIRLIFT_ALIAS:$expanded/.env.local"
  fi
  AIRLIFT_REMOTE_PROJECT="$expanded"
  if [ -n "$rel" ] && [ "$rel" != "$local_cwd" ]; then
    AIRLIFT_REMOTE_CWD="$expanded/$rel"
    ssh -o BatchMode=yes "$AIRLIFT_ALIAS" "mkdir -p $(shell_quote "$expanded/$rel")" >/dev/null
  else
    AIRLIFT_REMOTE_CWD="$expanded"
  fi
}

write_back_worktree() {
  local local_root="$1"
  local remote_root="$2"
  local owns_overlay="$3"
  if [ -n "${AIRLIFT_TEST_METRICS_DIR:-}" ]; then
    return 0
  fi
  [ -n "$remote_root" ] || return 0
  if [ "$owns_overlay" != "1" ]; then
    ssh -o BatchMode=yes "$AIRLIFT_ALIAS" \
      "git -C $(shell_quote "$remote_root") add -A >/dev/null 2>&1; git -C $(shell_quote "$remote_root") commit -m 'airlift autosave' >/dev/null 2>&1 || true"
    git fetch "$AIRLIFT_ALIAS:$remote_root" "HEAD:airlift/$(basename "$remote_root")" >/dev/null 2>&1 || true
    return 0
  fi
  # shellcheck disable=SC2046
  rsync -a --delete $(rsync_pull_excludes) \
    "$AIRLIFT_ALIAS:$remote_root/" "$local_root/"
}

run_agent_local() {
  local agent="$1"
  shift
  local cwd="$1"
  shift
  local real
  real="$(real_bin_path "$agent")" || die "No local $agent binary. Install it or join a worker."
  notify_airlift "pool empty or local mode, running $agent here"
  export AIRLIFT_IN_EXEC=1
  cd "$cwd"
  if [ "${AIRLIFT_ONESHOT:-0}" = "1" ]; then
    case "$agent" in
      codex) exec "$real" exec -C "$cwd" - ;;
      claude) exec "$real" -p ;;
    esac
  fi
  exec "$real" "$@"
}

hop_agent() {
  local agent="$1"
  local remote_cwd="$2"
  local quoted_agent quoted_cwd remote_script
  quoted_agent="$(shell_quote "$agent")"
  quoted_cwd="$(shell_quote "$remote_cwd")"
  remote_script='set -euo pipefail
export PATH="$HOME/.airlift/runtime/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.codex/bin:$PATH"
project="$AIRLIFT_CWD"
case "$project" in
  "~") project="$HOME" ;;
  "~/"*) project="$HOME/${project#\~/}" ;;
esac
[ -d "$project" ] || { printf "Remote project does not exist: %s\n" "$project" >&2; exit 1; }
mkdir -p "$HOME/.airlift/jobs"
lease="$(mktemp "$HOME/.airlift/jobs/job.XXXXXX")"
printf "%s\n" "$$" >"$lease"
printf "agent=%s\ncwd=%s\n" "$AIRLIFT_AGENT" "$project" >>"$lease"
cleanup() { rm -f "$lease"; }
trap cleanup EXIT
trap "exit 130" INT
trap "exit 143" HUP TERM
cd "$project"
case "$AIRLIFT_AGENT" in
  codex)
    command -v codex >/dev/null 2>&1 || { printf "Codex is not installed on this worker.\n" >&2; exit 1; }
    if [ "${AIRLIFT_ONESHOT:-0}" = "1" ]; then
      codex exec -C "$project" -
    else
      exec codex
    fi
    ;;
  claude)
    command -v claude >/dev/null 2>&1 || { printf "Claude Code is not installed on this worker.\n" >&2; exit 1; }
    if [ "${AIRLIFT_ONESHOT:-0}" = "1" ]; then
      claude -p
    else
      exec claude
    fi
    ;;
  *) printf "Unknown agent: %s\n" "$AIRLIFT_AGENT" >&2; exit 1 ;;
esac'
  if [ -n "${AIRLIFT_SSH_TTY:-}" ]; then
    ssh -t "$AIRLIFT_ALIAS" \
      "AIRLIFT_AGENT=$quoted_agent AIRLIFT_CWD=$quoted_cwd AIRLIFT_ONESHOT=$(shell_quote "${AIRLIFT_ONESHOT:-0}") bash -c $(shell_quote "$remote_script")"
  else
    ssh "$AIRLIFT_ALIAS" \
      "AIRLIFT_AGENT=$quoted_agent AIRLIFT_CWD=$quoted_cwd AIRLIFT_ONESHOT=$(shell_quote "${AIRLIFT_ONESHOT:-0}") bash -c $(shell_quote "$remote_script")"
  fi
}

exec_cmd() {
  load_config
  require ssh
  local agent="claude" worker="auto" cwd="$PWD"
  local -a agent_args=()
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --agent) [ "$#" -ge 2 ] || die "--agent needs a value."; agent="$2"; shift 2 ;;
      --worker) [ "$#" -ge 2 ] || die "--worker needs a value."; worker="$2"; shift 2 ;;
      --cwd) [ "$#" -ge 2 ] || die "--cwd needs a value."; cwd="$2"; shift 2 ;;
      --) shift; agent_args+=("$@"); break ;;
      -*) die "Unknown exec option: $1" ;;
      *) agent_args+=("$1"); shift ;;
    esac
  done
  case "$agent" in claude|codex) ;; *) die "Agent must be claude or codex." ;; esac
  [ -d "$cwd" ] || die "cwd does not exist: $cwd"
  local_cmd_exec "$agent" "$worker" "$cwd" 0 "${agent_args[@]+"${agent_args[@]}"}"
}

local_cmd_exec() {
  local agent="$1" worker="$2" cwd="$3" oneshot="$4"
  shift 4
  AIRLIFT_ONESHOT="$oneshot"
  local root lease lock_file owns=0 remote_root=""
  root="$(sync_root_for "$cwd")"
  if force_local_requested; then
    run_agent_local "$agent" "$cwd" "$@"
  fi
  if ! select_node "$worker" "$root" 0; then
    run_agent_local "$agent" "$cwd" "$@"
  fi
  load_node "$AIRLIFT_SELECTED_ALIAS"
  lease="$(lease_id | tr -d '\n')"
  lock_file="$(lock_path_for "$root")"
  if try_overlay_lock "$root" "$lease"; then
    owns=1
    trap 'release_overlay_lock "'"$lock_file"'"' EXIT
  fi
  if ! ensure_worktree "$root" "$cwd" "$lease"; then
    release_overlay_lock "$lock_file"
    run_agent_local "$agent" "$cwd" "$@"
  fi
  remote_root="$AIRLIFT_REMOTE_PROJECT"
  notify_airlift "running on $AIRLIFT_ALIAS ($AIRLIFT_SELECTED_MACHINE)"
  local hop_status=0
  if [ -t 0 ] && [ "$oneshot" != "1" ]; then
    AIRLIFT_SSH_TTY=1
  else
    AIRLIFT_SSH_TTY=""
  fi
  hop_agent "$agent" "$AIRLIFT_REMOTE_CWD" || hop_status=$?
  write_back_worktree "$root" "$remote_root" "$owns" || true
  release_overlay_lock "$lock_file"
  if [ "$owns" != "1" ]; then
    notify_airlift "edits on branch airlift/$lease (another agent owns this folder)"
  fi
  return "$hop_status"
}

local_cmd() {
  local action="${1:-status}"
  mkdir -p "$CONFIG_DIR"
  case "$action" in
    on)
      printf '1\n' >"$FORCE_LOCAL_FILE"
      chmod 600 "$FORCE_LOCAL_FILE"
      ok "Agents will stay on this Mac."
      ;;
    off)
      rm -f "$FORCE_LOCAL_FILE"
      ok "Agents hop when a house Mac is free."
      ;;
    status)
      if [ -f "$FORCE_LOCAL_FILE" ]; then
        say "local: on"
      else
        say "local: off (hop if a worker is up)"
      fi
      ;;
    *)
      die "Usage: airlift local on|off|status"
      ;;
  esac
}

run_cmd() {
  load_config
  require ssh
  local agent="codex" worker="auto" project="$AIRLIFT_PROJECT"
  local prompt="" after_options="0"
  while [ "$#" -gt 0 ]; do
    if [ "$after_options" = "1" ]; then
      prompt="${prompt}${prompt:+ }$1"
      shift
      continue
    fi
    case "$1" in
      --agent) [ "$#" -ge 2 ] || die "--agent needs a value."; agent="$2"; shift 2 ;;
      --worker) [ "$#" -ge 2 ] || die "--worker needs a value."; worker="$2"; shift 2 ;;
      --project) [ "$#" -ge 2 ] || die "--project needs a value."; project="$2"; shift 2 ;;
      --) after_options="1"; shift ;;
      -*) die "Unknown run option: $1" ;;
      *) prompt="${prompt}${prompt:+ }$1"; shift ;;
    esac
  done
  case "$agent" in codex|claude) ;; *) die "Agent must be codex or claude." ;; esac
  if [ -z "$prompt" ] && [ ! -t 0 ]; then prompt="$(cat)"; fi
  [ -n "$prompt" ] || die "Usage: airlift run [--agent codex|claude] [--project path] <message>"

  case "$project" in
    "~") project="$HOME" ;;
    "~/"*) project="$HOME/${project#\~/}" ;;
  esac

  printf '%s' "$prompt" | local_cmd_exec "$agent" "$worker" "$project" 1
}

clone_on_node() {
  local alias="$1" url="$2" destination="$3"
  load_node "$alias"
  local quoted_url quoted_destination
  quoted_url="$(shell_quote "$url")"
  quoted_destination="$(shell_quote "$destination")"
  info "Cloning on ${AIRLIFT_ALIAS}…"
  ssh "$AIRLIFT_ALIAS" "AIRLIFT_URL=$quoted_url AIRLIFT_DEST=$quoted_destination bash -s" <<'REMOTE'
set -eu
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.codex/bin:$PATH"
destination="$AIRLIFT_DEST"
case "$destination" in
  "~") destination="$HOME" ;;
  "~/"*) destination="$HOME/${destination#\~/}" ;;
esac
mkdir -p "$(dirname "$destination")"
git clone -- "$AIRLIFT_URL" "$destination"
printf 'Cloned to %s\n' "$destination"
REMOTE
}

clone_cmd() {
  load_config
  local worker="auto" url="" destination=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --worker) [ "$#" -ge 2 ] || die "--worker needs a value."; worker="$2"; shift 2 ;;
      -*) die "Unknown clone option: $1" ;;
      *)
        if [ -z "$url" ]; then url="$1"; elif [ -z "$destination" ]; then destination="$1"; else die "Too many clone arguments."; fi
        shift
        ;;
    esac
  done
  [ -n "$url" ] || die "Usage: airlift clone <git-url> [remote-directory] [--worker auto|name|all]"
  local name alias failures=0
  name="$(basename "${url%.git}")"
  [ -n "$destination" ] || destination="~/Developer/$name"

  if [ "$worker" = "all" ]; then
    while IFS= read -r alias; do
      [ -n "$alias" ] || continue
      if ! clone_on_node "$alias" "$url" "$destination"; then failures=$((failures + 1)); fi
    done < <(list_node_aliases)
    [ "$failures" -eq 0 ] || die "$failures worker(s) failed to clone the repository."
  else
    select_node "$worker" "~"
    clone_on_node "$AIRLIFT_SELECTED_ALIAS" "$url" "$destination"
  fi
  AIRLIFT_PROJECT="$destination"
  save_config
  ok "Saved $destination as the default pool project."
}

login_cmd() {
  local provider="codex" worker=""
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --worker) [ "$#" -ge 2 ] || die "--worker needs a value."; worker="$2"; shift 2 ;;
      codex|claude) provider="$1"; shift ;;
      *) die "Unknown login option: $1" ;;
    esac
  done
  load_command_node "$worker"
  case "$provider" in
    codex) ssh -t "$AIRLIFT_ALIAS" "$(remote_path_prefix) codex login --device-auth" ;;
    claude) ssh -t "$AIRLIFT_ALIAS" "$(remote_path_prefix) claude auth login" ;;
  esac
}

shell_cmd() {
  local worker="${1:-}"
  if [ "$worker" = "--worker" ]; then [ "$#" -ge 2 ] || die "--worker needs a value."; worker="$2"; fi
  load_command_node "$worker"
  exec ssh "$AIRLIFT_ALIAS"
}

awake_current_node() {
  ssh "$AIRLIFT_ALIAS" "bash -s" <<'REMOTE'
set -eu
mkdir -p "$HOME/.airlift/logs"
pid_file="$HOME/.airlift/caffeinate.pid"
if [ -f "$pid_file" ]; then
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    command_line="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    case "$command_line" in *caffeinate*) exit 0 ;; esac
  fi
fi
nohup /usr/bin/caffeinate -s >"$HOME/.airlift/logs/caffeinate.log" 2>&1 </dev/null &
printf '%s\n' "$!" >"$pid_file"
REMOTE
  ok "$AIRLIFT_ALIAS will stay awake while connected to AC power."
}

awake_cmd() {
  local worker=""
  while [ "$#" -gt 0 ]; do
    case "$1" in --worker) [ "$#" -ge 2 ] || die "--worker needs a value."; worker="$2"; shift 2 ;; *) die "Unknown awake option: $1" ;; esac
  done
  load_command_node "$worker"
  awake_current_node
}

sleep_current_node() {
  ssh "$AIRLIFT_ALIAS" "bash -s" <<'REMOTE'
set -eu
pid_file="$HOME/.airlift/caffeinate.pid"
if [ -f "$pid_file" ]; then
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    command_line="$(ps -p "$pid" -o command= 2>/dev/null || true)"
    case "$command_line" in *caffeinate*) kill "$pid" 2>/dev/null || true ;; esac
  fi
  rm -f "$pid_file"
fi
REMOTE
  ok "Released Airlift's keep-awake assertion on $AIRLIFT_ALIAS."
}

sleep_cmd() {
  local worker=""
  while [ "$#" -gt 0 ]; do
    case "$1" in --worker) [ "$#" -ge 2 ] || die "--worker needs a value."; worker="$2"; shift 2 ;; *) die "Unknown sleep option: $1" ;; esac
  done
  load_command_node "$worker"
  sleep_current_node
}

doctor_cmd() {
  local worker=""
  while [ "$#" -gt 0 ]; do
    case "$1" in --worker) [ "$#" -ge 2 ] || die "--worker needs a value."; worker="$2"; shift 2 ;; *) die "Unknown doctor option: $1" ;; esac
  done
  load_command_node "$worker"
  require ssh
  say ""
  say "${BOLD}Airlift doctor · $AIRLIFT_ALIAS${RESET}"
  say ""
  if ssh -o BatchMode=yes -o ConnectTimeout=8 "$AIRLIFT_ALIAS" true >/dev/null 2>&1; then
    ok "SSH connection to $AIRLIFT_ALIAS"
  else
    warn "SSH connection failed."
    say "Check Remote Login, power, and the configured $AIRLIFT_TRANSPORT network path."
    exit 1
  fi

  ssh "$AIRLIFT_ALIAS" "bash -s" <<'REMOTE'
set -u
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$HOME/.codex/bin:$PATH"
printf '\nRemote machine\n'
printf '  Name:    %s\n' "$(scutil --get ComputerName 2>/dev/null || hostname)"
printf '  macOS:   %s\n' "$(sw_vers -productVersion 2>/dev/null || printf unknown)"
printf '  Chip:    %s\n' "$(uname -m)"
printf '  Disk:    %s\n' "$(df -h "$HOME" | awk 'NR == 2 { print $4 " free" }')"
printf '\nAgents\n'
if command -v codex >/dev/null 2>&1; then
  printf '  Codex:   %s\n' "$(codex --version 2>/dev/null)"
  if codex login status >/dev/null 2>&1; then printf '  Auth:    ready\n'; else printf '  Auth:    sign-in required\n'; fi
else printf '  Codex:   not installed\n'; fi
if command -v claude >/dev/null 2>&1; then
  printf '  Claude:  %s\n' "$(claude --version 2>/dev/null)"
  if claude auth status >/dev/null 2>&1; then printf '  Auth:    ready\n'; else printf '  Auth:    sign-in required\n'; fi
else printf '  Claude:  not installed\n'; fi
if command -v yepanywhere >/dev/null 2>&1; then printf '  Cockpit: yepanywhere %s\n' "$(yepanywhere --version 2>/dev/null)"; else printf '  Cockpit: not installed\n'; fi
printf '\nPower\n'
if [ -f "$HOME/.airlift/caffeinate.pid" ]; then
  caffeinate_pid="$(cat "$HOME/.airlift/caffeinate.pid" 2>/dev/null || true)"
  if [ -n "$caffeinate_pid" ] && kill -0 "$caffeinate_pid" 2>/dev/null; then printf '  Airlift: keep-awake active on AC power\n'; fi
fi
REMOTE
  say ""
  say "Security: SSH key only, agent forwarding disabled, cockpit bound to worker loopback."
  if [ "$AIRLIFT_TRANSPORT" = "tailscale" ]; then say "Network: private Tailscale path; same Wi-Fi is not required."; fi
}

dashboard_cmd() {
  local port="$DASHBOARD_PORT" open_browser="1"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --port) [ "$#" -ge 2 ] || die "--port needs a value."; port="$2"; shift 2 ;;
      --no-open) open_browser="0"; shift ;;
      *) die "Unknown dashboard option: $1" ;;
    esac
  done
  validate_port "$port"
  require python3
  load_config optional || true

  local html="" script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  for cand in "$script_dir/dashboard.html" "$HOME/.local/share/airlift/dashboard.html"; do
    [ -f "$cand" ] && html="$cand" && break
  done
  [ -n "$html" ] || die "dashboard.html is missing. Re-run ./install.sh from the Airlift checkout."

  local bin
  bin="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  [ -x "$bin" ] || bin="$(command -v airlift || true)"
  [ -n "$bin" ] || die "Could not locate the airlift executable."

  local server
  server="$(mktemp "${TMPDIR:-/tmp}/airlift-dash.XXXXXX")"
  AIRLIFT_DASH_SERVER="$server"
  cat >"$server" <<'PY'
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import os
import subprocess
import sys

PORT = int(sys.argv[1])
HTML = open(os.environ["AIRLIFT_DASH_HTML"], encoding="utf-8").read().encode()
BIN = os.environ["AIRLIFT_DASH_BIN"]

class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        return

    def do_GET(self):
        path = self.path.split("?", 1)[0]
        if path in ("/", "/index.html"):
            body = HTML
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        if path == "/api/pool":
            try:
                body = subprocess.check_output([BIN, "nodes", "--json"], env=os.environ)
            except subprocess.CalledProcessError:
                body = b'{"generated_at":"","version":"","machines":[],"events":[]}'
            self.send_response(200)
            self.send_header("Content-Type", "application/json; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)
            return
        self.send_error(404)

if __name__ == "__main__":
    httpd = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    print("http://127.0.0.1:%s" % PORT, flush=True)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
PY
  cleanup_dash() {
    [ -n "${AIRLIFT_DASH_SERVER:-}" ] && rm -f "$AIRLIFT_DASH_SERVER"
  }
  trap cleanup_dash EXIT
  export AIRLIFT_DASH_HTML="$html"
  export AIRLIFT_DASH_BIN="$bin"
  info "Pool board at http://127.0.0.1:$port  (localhost only, Ctrl-C to stop)"
  if [ "$open_browser" = "1" ]; then
    if [ -n "${AIRLIFT_TEST_OPEN_LOG:-}" ]; then
      printf 'http://127.0.0.1:%s\n' "$port" >>"$AIRLIFT_TEST_OPEN_LOG"
    elif [ -z "${AIRLIFT_TEST_METRICS_DIR:-}" ]; then
      open "http://127.0.0.1:$port" >/dev/null 2>&1 || true
    fi
  fi
  python3 "$server" "$port"
}

config_cmd() {
  load_config
  cat <<EOF
Default worker: $AIRLIFT_DEFAULT_NODE
Project:        $AIRLIFT_PROJECT
Local port:     $AIRLIFT_LOCAL_PORT
Remote port:    $AIRLIFT_REMOTE_PORT
Config file:    $CONFIG_FILE
SSH key:        $KEY_FILE

Workers:
EOF
  local alias
  while IFS= read -r alias; do
    [ -n "$alias" ] || continue
    load_node "$alias"
    printf '  %-16s %-12s slots=%-5s %s\n' "$AIRLIFT_ALIAS" "$AIRLIFT_TRANSPORT" "$AIRLIFT_SLOTS" "$AIRLIFT_TARGET"
  done < <(list_node_aliases)
}

main() {
  local command="${1:-help}"
  if [ "$#" -gt 0 ]; then shift; fi
  case "$command" in
    setup) join_cmd setup "$@" ;;
    join|add) join_cmd join "$@" ;;
    nodes|pool|status) nodes_cmd "$@" ;;
    dashboard|dash|board) dashboard_cmd "$@" ;;
    run|dispatch|send) run_cmd "$@" ;;
    exec) exec_cmd "$@" ;;
    local) local_cmd "$@" ;;
    open|cockpit|web|codex|claude) cockpit_cmd "$@" ;;
    clone) clone_cmd "$@" ;;
    login) login_cmd "$@" ;;
    shell|ssh) shell_cmd "$@" ;;
    awake) awake_cmd "$@" ;;
    sleep) sleep_cmd "$@" ;;
    metrics) metrics_cmd "$@" ;;
    stop) stop_cmd "$@" ;;
    shutdown) shutdown_cmd "$@" ;;
    doctor) doctor_cmd "$@" ;;
    config) config_cmd "$@" ;;
    version|--version|-v) say "airlift $VERSION" ;;
    help|--help|-h) usage ;;
    *) usage; die "Unknown command: $command" ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
